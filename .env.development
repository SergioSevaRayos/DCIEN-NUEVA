# ============================================
# DESARROLLO LOCAL SIN BASE DE DATOS
# ============================================
# Este archivo permite ejecutar el proyecto localmente
# sin necesidad de configurar MySQL
# Las páginas que requieren BD mostrarán datos de ejemplo

DATABASE_URL="mysql://root:@localhost:3306/dcien_local"

# Stripe (Modo TEST - no funcional pero previene errores)
STRIPE_SECRET_KEY="sk_test_ejemplo_no_funcional"
STRIPE_PUBLIC_KEY="pk_test_ejemplo_no_funcional"
STRIPE_WEBHOOK_SECRET="whsec_ejemplo_no_funcional"

# App
APP_URL="http://localhost:4321"
JWT_SECRET="desarrollo_local_jwt_secret_key_min_32_chars_aqui"
