---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSEO } from '../../lib/seo';

const seo = getSEO('acceso');
---

<BaseLayout seo={seo}>
  <section class="min-h-[calc(100dvh-var(--header-height))] flex items-center justify-center pt-[var(--header-height)] pb-20">

    <div class="container-custom max-w-5xl mx-auto px-6 w-full">
      
      <div class="max-w-md mx-auto mb-12">
        <!-- Logo -->
        <h1 class="font-brand text-6xl md:text-7xl text-center mb-4 tracking-wider text-black dark:text-white">
          DCIEN
        </h1>
        <p class="text-xs text-center uppercase tracking-[0.3em] text-black/60 dark:text-white/60 mb-8">
          Acceso exclusivo mediante credenciales autorizadas
        </p>
        
        <div class="flex justify-center">
          <button id="btn-tour" type="button" class="text-[10px] uppercase tracking-[0.2em] text-black/40 dark:text-white/40 hover:text-black dark:hover:text-white transition-colors flex items-center gap-2">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="square" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            Guía de acceso
          </button>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-20 items-start">
        
        <!-- Columna Izquierda -->
        <div class="w-full">

          <!-- Protocolo de Acceso Informativo -->
          <div class="p-6 border border-black/10 dark:border-white/10 bg-zinc-50/50 dark:bg-zinc-900/30">
        <h2 class="text-xs font-bold uppercase tracking-[0.3em] text-black dark:text-white mb-6 text-center border-b border-black/5 dark:border-white/5 pb-4">
          Protocolo de Acceso
        </h2>
        <ul class="space-y-6 text-[10px] sm:text-[11px] uppercase tracking-[0.1em] sm:tracking-[0.15em] text-black/60 dark:text-white/60 leading-relaxed">
          <li class="flex items-start gap-4">
            <span class="font-mono text-black/30 dark:text-white/30 font-bold mt-0.5">01</span>
            <span><strong class="text-black dark:text-white font-medium">Solicitud:</strong> Síguenos en Instagram y pídenos acceso por mensaje privado.</span>
          </li>
          <li class="flex items-start gap-4">
            <span class="font-mono text-black/30 dark:text-white/30 font-bold mt-0.5">02</span>
            <span><strong class="text-black dark:text-white font-medium">Activación:</strong> Recibe credenciales provisionales y activa tu cuenta desde el enlace inferior.</span>
          </li>
          <li class="flex items-start gap-4">
            <span class="font-mono text-black/30 dark:text-white/30 font-bold mt-0.5">03</span>
            <span><strong class="text-black dark:text-white font-medium">Registro:</strong> Configura tu contraseña e inicia sesión para acceder al catálogo cerrado.</span>
          </li>
        </ul>
          </div>
        </div>

        <!-- Columna Derecha -->
        <div class="max-w-md mx-auto w-full">
          <!-- Form -->
      <form id="login-form" class="space-y-8" method="POST" onsubmit="event.preventDefault();">
        <div>
          <label for="identifier" class="block text-xs uppercase tracking-[0.2em] mb-3 text-black/60 dark:text-white/60">
            Usuario o Email
          </label>
          <!-- type="text" para admitir tanto username como email -->
          <input
            type="text"
            id="identifier"
            name="identifier"
            required
            autocomplete="username"
            class="input-minimal"
            placeholder="usuario o email@ejemplo.com"
          />
        </div>

        <div>
          <label for="password" class="block text-xs uppercase tracking-[0.2em] mb-3 text-black/60 dark:text-white/60">
            Contraseña
          </label>
          <input
            type="password"
            id="password"
            name="password"
            required
            autocomplete="current-password"
            class="input-minimal"
            placeholder="••••••••"
          />
        </div>

        <button type="submit" class="btn-primary w-full mt-12">
          Iniciar Operación
        </button>

        <div class="text-center mt-8">
          <button 
            type="button" 
            id="recover-btn" 
            class="text-xs text-black/40 dark:text-white/40 hover:text-black dark:hover:text-white transition-colors uppercase tracking-[0.2em]"
          >
            ¿Problemas de acceso? Recuperar credenciales
          </button>
        </div>
      </form>
      <div class="text-center mt-6">
        <a
          id="provisional-link"
          href="/registro/activar"
          class="text-xs uppercase tracking-[0.25em] text-black/50 dark:text-white/50
                hover:text-black dark:hover:text-white transition-colors inline-block p-2"
        >
          Tengo credenciales provisionales
        </a>
      </div>


      <!-- Separador -->
      <div class="relative my-12">
        <div class="absolute inset-0 flex items-center">
          <div class="w-full border-t border-black/10 dark:border-white/10"></div>
        </div>
        
        <div class="relative flex justify-center">
          <span class="bg-white dark:bg-black px-4 text-xs text-black/40 dark:text-white/40 uppercase tracking-wider transition-colors duration-500">
            o
          </span>
        </div>
      </div>

      <a 
        href="https://www.instagram.com/dcien.esp/" 
        target="_blank" 
        rel="noopener noreferrer"
        id="instagram-btn" 
        class="btn-secondary w-full flex items-center justify-center gap-3 no-underline"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          Seguir a DCIEN y solicitar acceso
        </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { driver } from 'driver.js';
  import 'driver.js/dist/driver.css';

  const loginForm = document.getElementById('login-form') as HTMLFormElement;
  const recoverBtn = document.getElementById('recover-btn');

  // --- TOUR INTERACTIVO ---
  function startAccesoTour() {
    const driverObj = driver({
      showProgress: true,
      animate: true,
      doneBtnText: '¡Entendido!',
      nextBtnText: 'Siguiente →',
      prevBtnText: '← Anterior',
      progressText: 'Paso {{current}} de {{total}}',
      steps: [
        {
          element: '#instagram-btn',
          popover: {
            title: '¿No tienes acceso?',
            description: 'Si es tu primera vez aquí y no tienes credenciales, síguenos en Instagram y pídenos acceso por mensaje privado.',
            side: 'bottom',
            align: 'start'
          }
        },
        {
          element: '#provisional-link',
          popover: {
            title: 'Credenciales Provisionales',
            description: 'Si ya te hemos dado una contraseña provisional por Instagram pero aún no te has registrado, pulsa aquí para activar tu cuenta.',
            side: 'bottom',
            align: 'start'
          }
        },
        {
          element: '#login-form',
          popover: {
            title: 'Acceso para Atletas',
            description: 'Si ya activaste tu cuenta y creaste tu propia contraseña, utiliza este formulario con tu usuario o email para entrar a la tienda.',
            side: 'top',
            align: 'start'
          }
        }
      ]
    });
    driverObj.drive();
  }

  const btnTour = document.getElementById('btn-tour');
  if (btnTour) {
    btnTour.addEventListener('click', startAccesoTour);
  }

  if (!localStorage.getItem('dcien_tour_acceso_visto')) {
    localStorage.setItem('dcien_tour_acceso_visto', 'true');
    setTimeout(startAccesoTour, 1000);
  }

  const getSwalConfig = () => {
    const isDark = document.documentElement.classList.contains('dark');
    return {
      background: isDark ? '#000' : '#fff',
      color: isDark ? '#fff' : '#000',
      confirmButtonColor: isDark ? '#fff' : '#000',
      cancelButtonColor: isDark ? '#666' : '#999',
      customClass: {
        confirmButton: isDark 
          ? '!bg-white !text-black font-bold uppercase tracking-wider text-xs px-8 py-3 rounded-none hover:!bg-white/90' 
          : '!bg-black !text-white font-bold uppercase tracking-wider text-xs px-8 py-3 rounded-none hover:!bg-black/90',
        cancelButton: '!bg-transparent !text-black dark:!text-white !border !border-black/20 dark:!border-white/20 font-bold uppercase tracking-wider text-xs px-8 py-3 rounded-none'
      }
    };
  };

  // Verificar si usuario ya está logueado
  async function checkIfLoggedIn() {
    try {
      const response = await fetch(import.meta.env.PUBLIC_API_URL + '/auth/check.php', {
        method: 'GET',
        credentials: 'include',
      });
      if (response.ok) {
        const data = await response.json();
        if (data.authenticated) {
          window.location.href = '/series-activas';
        }
      }
    } catch (error) {
      console.log('No hay sesión activa');
    }
  }

  checkIfLoggedIn();

  

  // Manejar submit del formulario
  loginForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = new FormData(loginForm);
    const identifier = (formData.get('identifier') as string).trim();
    const password = formData.get('password') as string;

    if (!identifier || !password) {
      const swalTheme = getSwalConfig();
      (window as any).Swal.fire({
        ...swalTheme,
        title: 'Error',
        text: 'Por favor, completa todos los campos',
        icon: 'error',
        confirmButtonText: 'Entendido',
      });
      return;
    }

    const submitBtn = loginForm.querySelector('button[type="submit"]') as HTMLButtonElement;
    const originalText = submitBtn.textContent;
    submitBtn.disabled = true;
    submitBtn.textContent = 'PROCESANDO...';

    try {
      const response = await fetch(import.meta.env.PUBLIC_API_URL + '/auth/login.php', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        // Se envía 'identifier' — el backend detecta si es email o username
        body: JSON.stringify({ identifier, password }),
      });

      const data = await response.json();

      if (response.ok && data.success) {

        // 🔁 NUEVO: usuario en onboarding
        if (data.requires_setup) {
          window.location.href = '/registro/completar';
          return;
        }

        // ✅ Usuario normal
        const swalTheme = getSwalConfig();
        (window as any).Swal.fire({
          ...swalTheme,
          title: 'Acceso Concedido',
          text: data.message || 'Bienvenido a DCIEN',
          icon: 'success',
          confirmButtonText: 'Continuar',
          timer: 2000,
          timerProgressBar: true,
        }).then(() => {
          window.location.href = '/series-activas';
        });
      }
      else {
        const swalTheme = getSwalConfig();
        (window as any).Swal.fire({
          ...swalTheme,
          title: 'Acceso Denegado',
          text: data.message || 'Credenciales incorrectas',
          icon: 'error',
          confirmButtonText: 'Reintentar',
        });
        submitBtn.disabled = false;
        submitBtn.textContent = originalText;
      }
    } catch (error) {
      console.error('Error de conexión:', error);
      const swalTheme = getSwalConfig();
      (window as any).Swal.fire({
        ...swalTheme,
        title: 'Error de Conexión',
        text: 'No se pudo conectar con el servidor. Inténtalo de nuevo.',
        icon: 'error',
        confirmButtonText: 'Entendido',
      });
      submitBtn.disabled = false;
      submitBtn.textContent = originalText;
    }
  });

  // Recuperar credenciales
  // Busca esta sección en el <script> de /acceso/index.astro y actualízala:
  recoverBtn?.addEventListener('click', () => {
    window.location.href = '/acceso/recuperar-contrasena';
  });
</script>