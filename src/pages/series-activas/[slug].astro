---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { seriesData } from '../../data/series';
import { getSeriesSEO, getProductSchema, getBreadcrumbSchema } from '../../lib/seo';
import NumberGrid from '../../components/NumberGrid.astro';

export async function getStaticPaths() {
  // Generamos páginas para TODAS las series (activas e inactivas)
  // El estado activo/archivado se comprueba en runtime via API
  return seriesData.map(series => ({ params: { slug: series.slug } }));
}

const { slug } = Astro.params;
const seriesInfo = seriesData.find(s => s.slug === slug);

if (!seriesInfo) return Astro.redirect('/series-activas');

const seoConfig = getSeriesSEO(
  seriesInfo.name,
  seriesInfo.description,
  seriesInfo.slug,
  seriesInfo.price,
  seriesInfo.images,
  100
);

const productSchema = getProductSchema(
  seriesInfo.name,
  seriesInfo.description,
  seriesInfo.slug,
  seriesInfo.price,
  seriesInfo.images,
  seriesInfo.isActive ? 'InStock' : 'OutOfStock'
);

const breadcrumbSchema = getBreadcrumbSchema([
  { name: 'Inicio', url: '/' },
  { name: 'Series Activas', url: '/series-activas' },
  { name: seriesInfo.name, url: `/series-activas/${seriesInfo.slug}` }
]);

const sizes = ['S', 'M', 'L', 'XL'];
const colors = [
  { name: 'Blanco', hex: '#FFFFFF', value: 'blanco' },
  { name: 'Negro', hex: '#000000', value: 'negro' }
];
const types = [
  { label: 'Standard Fit', value: 'standard' },
  { label: 'Oversize', value: 'king-size' }
];

const seriesPrice = seriesInfo.price;
const seriesSlug  = seriesInfo.slug;
const seriesName  = seriesInfo.name;
const apiUrl      = import.meta.env.PUBLIC_API_URL;
---

<BaseLayout seo={seoConfig}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  {/* Clases usadas en el countdown VIP inyectado dinámicamente — necesarias para que Tailwind las incluya */}
  <div class="hidden border border-black/10 dark:border-white/10 border-black/30 dark:border-white/30 text-black/40 dark:text-white/40 text-black/50 dark:text-white/50 text-black/60 dark:text-white/60 text-black dark:text-white font-mono text-xs font-bold tracking-[0.15em] tracking-[0.35em] py-6 space-y-3 w-full text-center text-[9px] text-[11px] px-3 py-1.5 inline-block align-middle ml-3"></div>

  <section class="relative pt-12 md:pt-28 pb-20 transition-colors duration-300">
    <div class="container-custom">
      <a href="/series-activas" class="inline-flex items-center gap-2 text-[10px] uppercase tracking-[0.2em] font-bold text-black/40 hover:text-black dark:text-white/40 dark:hover:text-white transition-colors mb-6 md:mb-10">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Volver a Protocolos
      </a>
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20">
        
        <div class="space-y-4">
          <div class="sticky top-24">
            <div class="relative group aspect-square bg-zinc-100 dark:bg-zinc-900 overflow-hidden">
              <div id="scroll-container" class="h-full flex snap-x snap-mandatory overflow-x-auto scrollbar-hide">
                {seriesInfo.images.map((img, idx) => (
                  <div class="min-w-full h-full snap-center flex items-center justify-center">
                    <img src={img} alt={seriesInfo.name} class="main-img-item w-full h-full object-contain cursor-zoom-in" loading={idx === 0 ? "eager" : "lazy"} />
                  </div>
                ))}
              </div>
              <button id="prev-img" class="absolute left-4 top-1/2 -translate-y-1/2 z-20 p-2 bg-white/10 backdrop-blur-md rounded-full text-white opacity-0 group-hover:opacity-100 transition-opacity">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
              </button>
              <button id="next-img" class="absolute right-4 top-1/2 -translate-y-1/2 z-20 p-2 bg-white/10 backdrop-blur-md rounded-full text-white opacity-0 group-hover:opacity-100 transition-opacity">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
              </button>
            </div>
            <div class="grid grid-cols-5 gap-2 mt-4">
              {seriesInfo.images.map((img, idx) => (
                <button class={`thumbnail-btn aspect-square border transition-all ${idx === 0 ? 'border-black dark:border-white' : 'border-transparent'}`}>
                  <img src={img} alt={`Miniatura de ${seriesInfo.name}`} class="w-full h-full object-cover opacity-60 hover:opacity-100 transition-opacity" />
                </button>
              ))}
            </div>
          </div>
        </div>

        <div class="flex flex-col">
          <header class="mb-8 relative">
            <div class="flex justify-between items-start mb-4">
              <h1 class="font-brand text-4xl md:text-5xl uppercase tracking-tighter text-black dark:text-white leading-none flex items-center gap-4">
                <span>{seriesInfo.name}</span>
                <span class="text-2xl md:text-3xl opacity-60 font-sans font-light" title={seriesInfo.gender === 'male' ? 'Hombre' : seriesInfo.gender === 'female' ? 'Mujer' : 'Unisex'}>
                  {seriesInfo.gender === 'male' && '♂'}
                  {seriesInfo.gender === 'female' && '♀'}
                  {seriesInfo.gender === 'unisex' && '♂/♀'}
                </span>
              </h1>
              <button id="btn-tour" type="button" class="text-[10px] uppercase tracking-[0.2em] text-black/40 dark:text-white/40 hover:text-black dark:hover:text-white transition-colors flex items-center gap-2 mt-2">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="square" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                Guía de compra
              </button>
            </div>
            <div class="flex items-end gap-3 mb-6">
              <span id="price-display" class="text-3xl font-light">€{seriesInfo.price.toFixed(2)}</span>
              <span class="text-xs text-black/60 dark:text-white/60 mb-1">IVA INCL.</span>
              <span id="price-original" class="text-xl font-light line-through text-black/30 dark:text-white/30 hidden"></span>
              <span id="price-badge" class="text-[10px] font-bold uppercase tracking-widest px-2 py-1 bg-black text-white dark:bg-white dark:text-black hidden"></span>
            </div>
          </header>

          <div class="space-y-8">
            <div id="tour-step-vars" class="space-y-8 p-4 -m-4 rounded-sm transition-colors">
              <div>
                <div class="flex justify-between items-center mb-3">
                  <label class="text-[10px] uppercase tracking-[0.2em] text-black/40 dark:text-white/40">Seleccionar Talla</label>
                  <button id="open-size-guide" class="text-[9px] uppercase tracking-widest text-black underline underline-offset-4 hover:opacity-60 dark:text-white transition-opacity">
                    Guía de tallas
                  </button>
                </div>
                <div class="flex flex-wrap gap-2">
                  {sizes.map(size => (
                    <label class="relative cursor-pointer group">
                      <input type="radio" name="size" value={size} class="peer sr-only" />
                      <span class="flex items-center justify-center w-11 h-11 border border-black/10 dark:border-white/10 peer-checked:border-black dark:peer-checked:border-white peer-checked:bg-black peer-checked:text-white dark:peer-checked:bg-white dark:peer-checked:text-black transition-all text-xs font-bold uppercase">{size}</span>
                    </label>
                  ))}
                </div>
              </div>

              <div>
                <label class="text-[10px] uppercase tracking-[0.2em] text-black/40 dark:text-white/40 mb-3 block">Color</label>
                <div class="flex flex-wrap gap-2">
                  {colors.map(color => (
                    <label class="relative cursor-pointer">
                      <input type="radio" name="color" value={color.value} class="peer sr-only" />
                      <span class="flex items-center gap-2 px-3 py-2 border border-black/10 dark:border-white/10 peer-checked:border-black dark:peer-checked:border-white transition-all h-11">
                        <span class="w-3 h-3 rounded-full border border-black/10" style={`background-color: ${color.hex}`}></span>
                        <span class="text-[10px] uppercase tracking-widest">{color.name}</span>
                      </span>
                    </label>
                  ))}
                </div>
              </div>

              <div>
                <label class="text-[10px] uppercase tracking-[0.2em] text-black/40 dark:text-white/40 mb-3 block">Corte de Prenda</label>
                <div class="grid grid-cols-2 gap-2">
                  {types.map(type => (
                    <label class="relative cursor-pointer">
                      <input type="radio" name="type" value={type.value} class="peer sr-only" />
                      <span class="flex items-center justify-center py-3 border border-black/10 dark:border-white/10 peer-checked:border-black dark:peer-checked:border-white transition-all text-[10px] uppercase tracking-widest h-11">{type.label}</span>
                    </label>
                  ))}
                </div>
              </div>
            </div>

            <div id="tour-step-grid" class="py-6 border-y border-black/5 dark:border-white/10">
              <div class="flex justify-between items-center mb-4">
                <h3 class="text-[10px] uppercase tracking-[0.2em] text-black/40 dark:text-white/40">Número de Serie</h3>
                <span class="text-[9px] uppercase tracking-widest text-black/40 dark:text-white/40">1/100 EXCLUSIVOS</span>
              </div>
              <NumberGrid seriesSlug={slug} />
            </div>

            <div class="space-y-6">
              <div id="stock-info" class="space-y-2">
                <div class="flex justify-between items-end">
                  <span class="text-[10px] tracking-[0.2em] uppercase font-bold text-black dark:text-white">Estado de la Serie</span>
                  <span id="stock-text" class="text-[10px] tracking-widest text-black/50 dark:text-white/50 uppercase">...</span>
                </div>
                <div class="w-full h-1.5 bg-black/5 dark:bg-white/5 overflow-hidden">
                  <div id="stock-bar" class="h-full bg-black dark:bg-white transition-all duration-700 ease-out" style="width: 0%"></div>
                </div>
              </div>


              <div id="buy-section">
                <button id="main-buy-button" disabled class="w-full py-5 bg-black text-white dark:bg-white dark:text-black uppercase text-xs tracking-[0.3em] font-bold disabled:opacity-20 transition-all">
                  Añadir al Carrito
                </button>
                <p id="error-msg" class="text-[10px] text-red-500 mt-3 text-center uppercase tracking-widest hidden">Completa la selección obligatoria</p>
              </div>
            </div>

            <div class="mt-8 border-t border-black/5 dark:border-white/10 pt-4">
              <div class="flex border-b border-black/5 dark:border-white/10 overflow-x-auto scrollbar-hide">
                <button data-tab="details" class="tab-btn active px-4 py-3 text-[10px] uppercase tracking-widest border-b-2 border-black dark:border-white transition-all">Detalles</button>
                <button data-tab="shipping" class="tab-btn px-4 py-3 text-[10px] uppercase tracking-widest border-b-2 border-transparent text-black/40 dark:text-white/40 transition-all">Envío</button>
              </div>
              <div class="py-6 min-h-[100px]">
                <div id="tab-details" class="tab-content text-[13px] text-black/70 dark:text-white/70 leading-relaxed">
                  <p>{seriesInfo.description}</p>
                </div>
                <div id="tab-shipping" class="tab-content hidden text-[13px] text-black/60 dark:text-white/60">
                  <p>Envío certificado urgente. Cada serie se prepara tras confirmación.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div id="size-guide-modal" class="fixed inset-0 z-[110] bg-black/80 backdrop-blur-md flex items-center justify-center opacity-0 pointer-events-none transition-all duration-500">
  <div class="bg-white dark:bg-zinc-950 w-full max-w-md p-0 relative mx-4 md:mt-16 shadow-[0_0_50px_-12px_rgba(0,0,0,0.5)] border border-black/5 dark:border-white/10 overflow-hidden max-h-[85vh] md:max-h-[75vh] overflow-y-auto scrollbar-hide">
    
    <div class="absolute top-0 left-0 w-full h-1 bg-zinc-100 dark:bg-zinc-800">
      <div class="h-full bg-black dark:bg-white w-1/3"></div>
    </div>

    <button id="close-size-guide" class="absolute top-6 right-6 z-10 text-black/20 dark:text-white/20 hover:text-black dark:hover:text-white transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
    
    <div class="p-8">
      <div class="flex flex-col items-center mb-8">
        <span class="text-[9px] uppercase tracking-[0.8em] text-black/30 dark:text-white/30 mb-2">Technical Specs</span>
        <h3 class="text-sm uppercase tracking-[0.4em] font-bold text-black dark:text-white">Guía de Tallas</h3>
      </div>

      <div class="relative w-full aspect-square max-w-[200px] mx-auto mb-8 bg-zinc-50 dark:bg-white/[0.02] border border-black/5 dark:border-white/5 p-4 flex items-center justify-center rounded-sm">
        <div class="absolute top-2 left-2 w-2 h-2 border-t border-l border-black/20 dark:border-white/20"></div>
        <div class="absolute top-2 right-2 w-2 h-2 border-t border-r border-black/20 dark:border-white/20"></div>
        <div class="absolute bottom-2 left-2 w-2 h-2 border-b border-l border-black/20 dark:border-white/20"></div>
        <div class="absolute bottom-2 right-2 w-2 h-2 border-b border-r border-black/20 dark:border-white/20"></div>

        <svg viewBox="0 0 200 200" class="w-full h-full overflow-visible" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M65 30 Q100 50 135 30 L180 50 L160 80 L145 70 L145 170 L55 170 L55 70 L40 80 L20 50 Z" 
                class="stroke-black/80 dark:stroke-white/80" stroke-width="1.5" stroke-linejoin="round"/>
          
          <path d="M75 35 Q100 60 125 35" class="stroke-black/30 dark:stroke-white/30" stroke-width="1" stroke-dasharray="2 2"/>
          
          <line x1="45" y1="95" x2="155" y2="95" class="stroke-black/50 dark:stroke-white/50" stroke-width="1" stroke-dasharray="3 3"/>
          <path d="M50 90 L45 95 L50 100" class="stroke-black/50 dark:stroke-white/50" stroke-width="1"/>
          <path d="M150 90 L155 95 L150 100" class="stroke-black/50 dark:stroke-white/50" stroke-width="1"/>
          <rect x="75" y="87" width="50" height="16" class="fill-zinc-50 dark:fill-zinc-950"/>
          <text x="100" y="98" class="fill-black dark:fill-white text-[8px] font-mono tracking-widest" text-anchor="middle">ANCHO</text>

          <line x1="110" y1="40" x2="110" y2="185" class="stroke-black/50 dark:stroke-white/50" stroke-width="1" stroke-dasharray="3 3"/>
          <path d="M105 45 L110 40 L115 45" class="stroke-black/50 dark:stroke-white/50" stroke-width="1"/>
          <path d="M105 180 L110 185 L115 180" class="stroke-black/50 dark:stroke-white/50" stroke-width="1"/>
          <rect x="94" y="110" width="32" height="16" class="fill-zinc-50 dark:fill-zinc-950"/>
          <text x="110" y="121" class="fill-black dark:fill-white text-[8px] font-mono tracking-widest" text-anchor="middle">LARGO</text>
        </svg>
      </div>

      <div class="flex gap-2 mb-6 bg-zinc-50 dark:bg-zinc-900/50 p-1 rounded-sm">
        <button data-fit-tab="standard" class="fit-tab-btn active flex-1 py-2 text-[10px] uppercase tracking-widest font-bold transition-all bg-white dark:bg-zinc-800 shadow-sm text-black dark:text-white">
          Standard
        </button>
        <button data-fit-tab="king" class="fit-tab-btn flex-1 py-2 text-[10px] uppercase tracking-widest font-bold transition-all text-black/40 dark:text-white/40 hover:text-black dark:hover:text-white">
          Oversize
        </button>
      </div>

      <div id="fit-standard" class="fit-content animate-in fade-in duration-500">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="text-[9px] uppercase tracking-[0.3em] text-black/40 dark:text-white/40 border-b border-black/5 dark:border-white/10">
              <th class="pb-3 font-medium">Talla</th>
              <th class="pb-3 font-medium text-center">Ancho (cm)</th>
              <th class="pb-3 font-medium text-right">Largo (cm)</th>
            </tr>
          </thead>
          <tbody class="text-xs font-mono tracking-tighter text-black/80 dark:text-white/90">
            <tr class="border-b border-black/[0.03] dark:border-white/[0.03] hover:bg-zinc-50 dark:hover:bg-white/[0.02] transition-colors">
              <td class="py-3 font-sans font-bold text-[11px]">S</td><td class="py-3 text-center tabular-nums">47.0</td><td class="py-3 text-right tabular-nums">68.0</td>
            </tr>
            <tr class="border-b border-black/[0.03] dark:border-white/[0.03] hover:bg-zinc-50 dark:hover:bg-white/[0.02] transition-colors">
              <td class="py-3 font-sans font-bold text-[11px]">M</td><td class="py-3 text-center tabular-nums">50.0</td><td class="py-3 text-right tabular-nums">71.0</td>
            </tr>
            <tr class="border-b border-black/[0.03] dark:border-white/[0.03] hover:bg-zinc-50 dark:hover:bg-white/[0.02] transition-colors">
              <td class="py-3 font-sans font-bold text-[11px]">L</td><td class="py-3 text-center tabular-nums">53.0</td><td class="py-3 text-right tabular-nums">74.0</td>
            </tr>
            <tr class="border-b border-black/[0.03] dark:border-white/[0.03] hover:bg-zinc-50 dark:hover:bg-white/[0.02] transition-colors">
              <td class="py-3 font-sans font-bold text-[11px]">XL</td><td class="py-3 text-center tabular-nums">56.0</td><td class="py-3 text-right tabular-nums">77.0</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div id="fit-king" class="fit-content hidden animate-in fade-in duration-500">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="text-[9px] uppercase tracking-[0.3em] text-black/40 dark:text-white/40 border-b border-black/5 dark:border-white/10">
              <th class="pb-3 font-medium">Talla</th>
              <th class="pb-3 font-medium text-center">Ancho (cm)</th>
              <th class="pb-3 font-medium text-right">Largo (cm)</th>
            </tr>
          </thead>
          <tbody class="text-xs font-mono tracking-tighter text-black/80 dark:text-white/90">
            <tr class="border-b border-black/[0.03] dark:border-white/[0.03] hover:bg-zinc-50 dark:hover:bg-white/[0.02] transition-colors">
              <td class="py-3 font-sans font-bold text-[11px]">M</td><td class="py-3 text-center tabular-nums">57.0</td><td class="py-3 text-right tabular-nums">69.0</td>
            </tr>
            <tr class="border-b border-black/[0.03] dark:border-white/[0.03] hover:bg-zinc-50 dark:hover:bg-white/[0.02] transition-colors">
              <td class="py-3 font-sans font-bold text-[11px]">L</td><td class="py-3 text-center tabular-nums">60.0</td><td class="py-3 text-right tabular-nums">72.0</td>
            </tr>
            <tr class="border-b border-black/[0.03] dark:border-white/[0.03] hover:bg-zinc-50 dark:hover:bg-white/[0.02] transition-colors">
              <td class="py-3 font-sans font-bold text-[11px]">XL</td><td class="py-3 text-center tabular-nums">63.0</td><td class="py-3 text-right tabular-nums">75.0</td>
            </tr>
            <tr class="border-b border-black/[0.03] dark:border-white/[0.03] hover:bg-zinc-50 dark:hover:bg-white/[0.02] transition-colors">
              <td class="py-3 font-sans font-bold text-[11px]">XXL</td><td class="py-3 text-center tabular-nums">66.0</td><td class="py-3 text-right tabular-nums">78.0</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="mt-6 p-3 bg-zinc-50 dark:bg-zinc-900/50 rounded-sm">
        <p id="fit-description" class="text-[9px] text-black/50 dark:text-white/40 leading-relaxed uppercase tracking-widest italic">
          Corte recto estándar. Talla habitual para un ajuste óptimo.
        </p>
      </div>

      <div class="mt-6 pt-6 border-t border-black/5 dark:border-white/10 flex justify-between items-center text-[8px] text-black/20 dark:text-white/20 uppercase tracking-[0.3em]">
        <span>Ref: DCIEN-SYS-SPEC</span>
        <span>© 2026</span>
      </div>
    </div>
  </div>
</div>

  <div id="image-overlay" class="fixed inset-0 z-[100] bg-white/95 dark:bg-black/95 flex items-center justify-center opacity-0 pointer-events-none transition-all duration-300">
    <button id="close-overlay" class="absolute top-8 right-8 text-black dark:text-white"><svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
    <img id="overlay-img" src="" alt="Vista ampliada" class="max-w-[90vw] max-h-[90vh] object-contain" />
  </div>
</BaseLayout>

<script define:vars={{ seriesPrice, seriesSlug, seriesName, apiUrl }}>
  const API = apiUrl;
  let selectedNumber  = null;

  // ═══════════════════════════════════════════════════════════
  // ACCESO PRIORITARIO / SERIE ARCHIVADA
  // ═══════════════════════════════════════════════════════════
  (async function checkAccess() {
    try {
      const r    = await fetch(`${API}/series/priority-status.php?slug=${seriesSlug}`);
      const data = await r.json();

      // Serie archivada (is_active = false en BD)
      if (data.is_active === false) {
        const buySection = document.getElementById('buy-section');
        const gridSection = document.getElementById('tour-step-grid');
        const badgeContainer = document.querySelector('header .flex.items-end');
        if (buySection) {
          buySection.innerHTML = `
            <div class="w-full py-5 border border-black/10 dark:border-white/10 text-center">
              <p class="text-xs uppercase tracking-[0.3em] text-black/40 dark:text-white/40">Serie Archivada — Producción Cerrada</p>
            </div>`;
        }
        if (gridSection) gridSection.style.display = 'none';
        return;
      }

      // Modo prioritario activo
      if (data.in_priority_mode && !data.user_has_access) {
        const buySection  = document.getElementById('buy-section');
        const gridSection = document.getElementById('tour-step-grid');
        const until       = new Date(data.priority_until + (data.priority_until.includes('T') ? '' : ' UTC'));

        if (gridSection) gridSection.style.display = 'none';
        if (buySection) {
          const cd = document.createElement('div');
          cd.id = 'priority-countdown';
          buySection.replaceWith(cd);
          document.getElementById('priority-countdown').innerHTML = `
            <div class="w-full py-6 border border-black/10 dark:border-white/10 text-center space-y-3">
              <p class="text-[9px] uppercase tracking-[0.35em] text-black/40 dark:text-white/40">Acceso Prioritario Activo</p>
              <p class="text-[11px] font-bold tracking-[0.15em] uppercase text-black dark:text-white">
                Apertura el ${until.toLocaleDateString('es-ES',{day:'2-digit',month:'long',year:'numeric'})}
              </p>
              <p id="vip-countdown" class="font-mono text-xs text-black/50 dark:text-white/50">...</p>
            </div>`;
          function updateCd() {
            const diff = Math.max(0, until - Date.now());
            if (!diff) { document.getElementById('vip-countdown').textContent = 'Abre ahora'; return; }
            const d = Math.floor(diff/86400000);
            const h = Math.floor((diff%86400000)/3600000);
            const m = Math.floor((diff%3600000)/60000);
            const s = Math.floor((diff%60000)/1000);
            document.getElementById('vip-countdown').textContent =
              (d > 0 ? d+'d ' : '') + String(h).padStart(2,'0') + ':' + String(m).padStart(2,'0') + ':' + String(s).padStart(2,'0');
          }
          updateCd();
          setInterval(updateCd, 1000);
        }
        return;
      }

      // Acceso VIP propio → mostrar badge
      if (data.in_priority_mode && data.user_has_access) {
        const header = document.querySelector('header h1');
        if (header) {
          const badge = document.createElement('span');
          badge.className = 'text-[9px] font-bold tracking-[0.2em] px-3 py-1.5 uppercase border border-black/30 dark:border-white/30 text-black/60 dark:text-white/60 inline-block align-middle ml-3';
          badge.textContent = 'ACCESO VIP';
          header.appendChild(badge);
        }
      }
    } catch {}
  })();

