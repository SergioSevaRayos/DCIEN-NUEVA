    if (!size || !color || !type || !selectedNumber) {
      errorMsg?.classList.remove('hidden'); 
      return;
    }

    errorMsg?.classList.add('hidden');
    
    // IMPORTANTE: Incluir originalPrice, finalPrice y discount
    const cartItem = {
      seriesSlug,
