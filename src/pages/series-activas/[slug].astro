  // ═══════════════════════════════════════════════════════════
// GALERÍA DE IMÁGENES
// ═══════════════════════════════════════════════════════════
const scrollContainer = document.getElementById('scroll-container');
const thumbButtons    = document.querySelectorAll('.thumbnail-btn');
const mainImgs        = document.querySelectorAll('.main-img-item');

// ── Flechas ──────────────────────────────────────────────
function getCurrentIndex() {
  if (!scrollContainer) return 0;
  return Math.round(scrollContainer.scrollLeft / scrollContainer.offsetWidth);
}

function scrollToIndex(idx) {
  const total = thumbButtons.length;
  const clamped = Math.max(0, Math.min(idx, total - 1));
  scrollContainer?.scrollTo({ left: scrollContainer.offsetWidth * clamped, behavior: 'smooth' });
  thumbButtons.forEach(b => b.classList.remove('border-black', 'dark:border-white'));
  thumbButtons[clamped]?.classList.add('border-black', 'dark:border-white');
}

document.getElementById('prev-img')?.addEventListener('click', () => {
  scrollToIndex(getCurrentIndex() - 1);
});

document.getElementById('next-img')?.addEventListener('click', () => {
  scrollToIndex(getCurrentIndex() + 1);
});

// ── Miniaturas ───────────────────────────────────────────
thumbButtons.forEach((btn, idx) => {
  btn.addEventListener('click', () => scrollToIndex(idx));
});

// ── Zoom / Ampliar imagen ────────────────────────────────
// ── Zoom / Ampliar imagen con Funcionalidad de Lupa ──────
const overlay    = document.getElementById('image-overlay');
const overlayImg = document.getElementById('overlay-img');
let isZoomed     = false; // Estado del zoom

function openOverlay(src) {
  if (!overlay || !overlayImg) return;
  overlayImg.src = src;
  overlay.style.opacity = '1';
  overlay.style.pointerEvents = 'auto';
  document.body.style.overflow = 'hidden';
  
  // Resetear el zoom al abrir
  isZoomed = false;
  overlayImg.style.transform = 'scale(1)';
  overlayImg.style.cursor = 'zoom-in';
  overlayImg.style.transition = 'transform 0.3s ease'; // Transición suave
}

function closeOverlay() {
  if (!overlay) return;
  overlay.style.opacity = '0';
  overlay.style.pointerEvents = 'none';
  document.body.style.overflow = '';
  
  // Resetear el zoom al cerrar para la próxima vez
  setTimeout(() => {
    isZoomed = false;
    overlayImg.style.transform = 'scale(1)';
  }, 300); // Esperar a que termine la animación de cierre
}

mainImgs.forEach(img => {
  img.addEventListener('click', () => openOverlay(img.src));
});

// Lógica del Zoom interactivo
overlayImg?.addEventListener('click', (e) => {
  // Evitar que el clic cierre el overlay (burbujeo)
  e.stopPropagation();
  
  if (!isZoomed) {
    // Ampliar
    overlayImg.style.transform = 'scale(2.5)'; // Nivel de zoom técnico
    overlayImg.style.cursor = 'zoom-out';
    isZoomed = true;
  } else {
    // Reducir
    overlayImg.style.transform = 'scale(1)';
    overlayImg.style.cursor = 'zoom-in';
    isZoomed = false;
  }
});

// Si hace zoom, permitir mover el ratón para ver la imagen desplazada (opcional pero muy pro)
overlayImg?.addEventListener('mousemove', (e) => {
  if (isZoomed) {
    const rect = overlayImg.getBoundingClientRect();
    const x = e.clientX - rect.left; // Posición X del ratón dentro de la imagen
    const y = e.clientY - rect.top;  // Posición Y del ratón dentro de la imagen
    
    // Convertir a porcentajes
    const originX = (x / rect.width) * 100;
    const originY = (y / rect.height) * 100;
    
    overlayImg.style.transformOrigin = `${originX}% ${originY}%`;
  } else {
    // Centro por defecto si no hay zoom
    overlayImg.style.transformOrigin = 'center center';
  }
});

document.getElementById('close-overlay')?.addEventListener('click', closeOverlay);

// Cerrar al hacer clic fuera de la imagen (en el fondo oscuro)
overlay?.addEventListener('click', (e) => { 
  if (e.target === overlay) closeOverlay(); 
});

// Cerrar con Escape
document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') closeOverlay();
});



