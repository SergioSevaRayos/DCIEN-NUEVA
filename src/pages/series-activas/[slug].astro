</script>

<script>
  import { addToCart } from '../../scripts/cart.js';

  window.addEventListener('cart:addItem', (e) => {
    const { item, discounts, discount } = (e as CustomEvent).detail;
    const result = addToCart(item, discounts ?? discount);

    const btn = document.getElementById('main-buy-button') as HTMLButtonElement | null;
    if (btn) {
      if (result === null) {
        const original = btn.textContent;
        btn.textContent = 'Ya en el carrito';
        btn.disabled = true;
        setTimeout(() => {
          btn.textContent = original;
          btn.disabled = false;
        }, 1800);
        window.dispatchEvent(new CustomEvent('cart:open'));
        return;
      }
      const original = btn.textContent;
      btn.textContent = '✓ Añadido';
      btn.disabled = true;
      setTimeout(() => {
        btn.textContent = original;
        btn.disabled = false;
      }, 1800);
    }

    window.dispatchEvent(new CustomEvent('cart:open'));
  });
</script>

