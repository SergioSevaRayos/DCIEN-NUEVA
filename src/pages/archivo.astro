---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSEO, getWebPageSchema, type SEOConfig } from '../lib/seo';

const seo: SEOConfig = getSEO('archivo');
const schema = getWebPageSchema(seo.title, seo.description, Astro.url.href);
const apiUrl = import.meta.env.PUBLIC_API_URL;

const lifestyleImages = [
  '/images/brand/filosofia.webp',
  '/images/brand/identidad5.webp',
  '/images/brand/identidad3.webp',
  '/images/brand/identidad6.webp',
  '/images/brand/identidad4.webp',
];
---

<BaseLayout seo={seo}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>

  <main class="relative z-10">
    <section class="pt-32 pb-32 px-6 min-h-screen">
      <div class="max-w-[1400px] mx-auto">

        <!-- CABECERA DE LA GALERÍA -->
        <div class="mb-24 animate-fade-in flex flex-col md:flex-row md:items-end justify-between border-b border-black/10 dark:border-white/10 pb-12">
          <div>
            <h1 class="font-brand text-6xl md:text-[8rem] tracking-[0.05em] text-black dark:text-white leading-none mb-4">
              ARCHIVO
            </h1>
            <p class="text-[10px] md:text-xs uppercase tracking-[0.5em] text-black/40 dark:text-white/40">
              Catálogo de Obras Finalizadas
            </p>
          </div>
          <div class="mt-8 md:mt-0 max-w-xs text-right">
            <p class="text-[9px] uppercase tracking-[0.3em] text-black/40 dark:text-white/30 leading-relaxed font-mono">
              Los protocolos mostrados aquí representan producciones únicas cerradas de manera permanente. Nunca volverán a estar disponibles.
            </p>
          </div>
        </div>

        <!-- Contenedor dinámico — JS rellena con series archivadas de la BD -->
        <div id="archivo-empty" class="hidden text-center py-32">
          <p class="text-[11px] uppercase tracking-[0.4em] text-black/30 dark:text-white/30 italic font-mono">
            — EL ARCHIVO SE ENCUENTRA VACÍO EN ESTE CICLO —
          </p>
        </div>

        <div id="archivo-grid" class="columns-1 md:columns-2 lg:columns-3 gap-8 space-y-8 animate-slide-up"></div>

        <!-- BOTÓN REGRESO -->
        <div class="mt-32 flex justify-center animate-slide-up" style="animation-delay: 0.4s;">
          <a
            href="/series-activas"
            class="group relative px-10 py-5 overflow-hidden border border-black/20 dark:border-white/20 bg-transparent transition-all duration-500 hover:border-black dark:hover:border-white inline-block"
          >
            <span class="absolute inset-0 w-0 bg-black dark:bg-white transition-all duration-500 ease-out group-hover:w-full"></span>
            <span class="relative flex items-center gap-4 text-center">
              <span class="text-[10px] uppercase tracking-[0.5em] font-bold text-black dark:text-white group-hover:text-white dark:group-hover:text-black transition-colors duration-500">
                Volver a Protocolos Activos
              </span>
            </span>
          </a>
        </div>

      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .animate-fade-in {
    animation: fadeIn 1.5s ease-out forwards;
  }
  .animate-slide-up {
    opacity: 0;
    animation: slideUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes fadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  @keyframes slideUp {
    from { opacity: 0; transform: translateY(40px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .art-item.from-left {
    opacity: 0;
    transform: translateX(-40px);
    transition: opacity 1s ease-out, transform 1s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .art-item.from-right {
    opacity: 0;
    transform: translateX(40px);
    transition: opacity 1s ease-out, transform 1s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .art-item.from-bottom {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 1s ease-out, transform 1s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .art-item[data-entered="true"] {
    opacity: 1;
    transform: translate(0, 0);
  }
</style>

<script define:vars={{ apiUrl, lifestyleImages }}>
const API = apiUrl;

const directions = ['from-left', 'from-right', 'from-bottom'];

function lifestyleHtml(src, idx) {
  const dir = directions[idx % directions.length];
  return `<article class="art-item ${dir} break-inside-avoid relative group overflow-hidden bg-white dark:bg-black border border-black/5 dark:border-white/5" data-active="false" data-entered="false">
    <div class="relative overflow-hidden">
      <img src="${src}" alt="DCIEN Brand Identity" class="w-full h-auto object-cover grayscale opacity-40 transition-all duration-1000 group-hover:scale-105 group-hover:grayscale-0 group-hover:opacity-100 group-data-[active=true]:scale-105 group-data-[active=true]:grayscale-0 group-data-[active=true]:opacity-100" loading="lazy" />
    </div>
  </article>`;
}

function serieHtml(s, idx) {
  const dir = directions[idx % directions.length];
  const img = s.images?.[0] ?? '/images/brand/og-image.jpg';
  const year = s.release_date ? new Date(s.release_date).getFullYear() : new Date().getFullYear();
  return `<article class="art-item ${dir} break-inside-avoid relative group cursor-crosshair overflow-hidden bg-white dark:bg-black border border-black/5 dark:border-white/5" data-active="false" data-entered="false">
    <div class="relative overflow-hidden">
      <img src="${img}" alt="${s.name} — Archivo DCIEN" class="w-full h-auto object-cover grayscale opacity-60 transition-all duration-1000 group-hover:scale-105 group-hover:grayscale-0 group-hover:opacity-100 group-data-[active=true]:scale-105 group-data-[active=true]:grayscale-0 group-data-[active=true]:opacity-100" loading="lazy" />
      <div class="absolute inset-0 bg-black/40 dark:bg-black/40 group-hover:bg-transparent group-data-[active=true]:bg-transparent transition-colors duration-1000 z-10 pointer-events-none"></div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 p-6 md:p-8 bg-gradient-to-t from-white via-white/90 dark:from-black dark:via-black/80 to-transparent z-20 translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 group-data-[active=true]:translate-y-0 group-data-[active=true]:opacity-100 transition-all duration-700 ease-out">
      <div class="flex justify-between items-end border-b border-black/10 dark:border-white/20 pb-4 mb-4">
        <h2 class="font-brand text-3xl md:text-4xl text-black dark:text-white uppercase tracking-wider">${s.name}</h2>
        <span class="text-[10px] text-black/50 dark:text-white/50 font-mono tracking-widest">${year}</span>
      </div>
      <p class="text-[9px] uppercase tracking-[0.2em] text-black/60 dark:text-white/60 leading-relaxed font-sans w-3/4">${s.description}</p>
      <div class="mt-6 flex gap-4">
        <span class="text-[8px] uppercase tracking-[0.4em] text-black/40 dark:text-white/30 border border-black/10 dark:border-white/10 px-2 py-1">Status: Archivada</span>
        <span class="text-[8px] uppercase tracking-[0.4em] text-black/40 dark:text-white/30 border border-black/10 dark:border-white/10 px-2 py-1">Prod: 100 Uds.</span>
      </div>
    </div>
  </article>`;
}

async function loadArchivo() {
  const grid = document.getElementById('archivo-grid');
  if (!grid) return;
  let series = [];
  try {
    const res  = await fetch(`${API}/series/list.php?status=archived`);
    const data = await res.json();
    series = data.series ?? [];
  } catch { return; }

  if (series.length === 0) {
    document.getElementById('archivo-empty')?.classList.remove('hidden');
    return;
  }

  const items = [];
  let liIdx   = 0;
  series.forEach((s, i) => {
    items.push(serieHtml(s, items.length));
    if (i % 2 === 0 && liIdx < lifestyleImages.length) {
      items.push(lifestyleHtml(lifestyleImages[liIdx++], items.length));
    }
  });
  while (liIdx < lifestyleImages.length) {
    items.push(lifestyleHtml(lifestyleImages[liIdx++], items.length));
  }
  grid.innerHTML = items.join('');
  initObservers();
}

function initObservers() {
  const entryObserver = new IntersectionObserver((entries, observer) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.setAttribute('data-entered', 'true');
        observer.unobserve(entry.target);
      }
    });
  }, { root: null, rootMargin: '0px 0px -10% 0px', threshold: 0 });

  const items = document.querySelectorAll('.art-item');
  items.forEach(item => entryObserver.observe(item));

  if (window.innerWidth <= 768) {
    const activeObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        entry.target.setAttribute('data-active', entry.isIntersecting ? 'true' : 'false');
      });
    }, { root: null, rootMargin: '-30% 0px -30% 0px', threshold: 0 });
    items.forEach(item => activeObserver.observe(item));
  }
}

document.addEventListener('DOMContentLoaded', loadArchivo);
</script>