---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EmailGate from '../../components/EmailGate.astro';
import PacingCalculator from '../../components/PacingCalculator.astro';
import ProtocolEngine from '../../components/ProtocolEngine.astro';
import MacroCalculator from '../../components/MacroCalculator.astro';
import { arsenalTools, getArsenalToolBySlug } from '../../data/arsenal';
import { getArsenalToolSEO } from '../../lib/seo';

export async function getStaticPaths() {
  return arsenalTools.map((tool) => ({ params: { slug: tool.slug } }));
}

const { slug } = Astro.params;
const tool = getArsenalToolBySlug(slug as string);

if (!tool) {
  return Astro.redirect('/arsenal');
}

// Mapa slug -> componente de la herramienta real. Cada herramienta nueva
// añade su entrada aquí y en src/data/arsenal.ts.
const toolComponents: Record<string, any> = {
  'calculadora-pacing': PacingCalculator,
  'motor-de-protocolos': ProtocolEngine,
  'calculadora-macros': MacroCalculator,
};

const ToolComponent = toolComponents[tool.slug];
const seo = getArsenalToolSEO(tool.name, tool.description, tool.slug, tool.keywords, tool.image);
---

<BaseLayout seo={seo}>
  <section class="pt-32 pb-24 transition-colors duration-500">
    <div class="container-custom max-w-3xl mx-auto">
      <a href="/arsenal" class="inline-flex items-center gap-2 text-[10px] uppercase tracking-[0.2em] font-bold text-black/40 hover:text-black dark:text-white/40 dark:hover:text-white transition-colors mb-10">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Volver al Arsenal
      </a>

      <div class="flex items-start justify-between gap-4 flex-wrap mb-4">
        <h1 class="font-brand text-4xl md:text-6xl text-black dark:text-white uppercase tracking-wider leading-none">
          {tool.name}
        </h1>
        <button
          id="share-button"
          type="button"
          class="inline-flex items-center gap-2 text-[10px] uppercase tracking-[0.2em] font-bold text-black/40 hover:text-black dark:text-white/40 dark:hover:text-white transition-colors shrink-0 mt-2"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M4 12v8a2 2 0 002 2h12a2 2 0 002-2v-8M16 6l-4-4-4 4M12 2v13"/></svg>
          Compartir
        </button>
      </div>
      <p class="text-sm text-black/60 dark:text-white/60 leading-relaxed mb-12 max-w-2xl">
        {tool.description}
      </p>

      <EmailGate toolSlug={tool.slug} toolName={tool.name}>
        {ToolComponent && <ToolComponent />}
      </EmailGate>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ toolTitle: tool.name, toolDescription: tool.description }}>
  const shareButton = document.getElementById('share-button');
  if (shareButton) {
    shareButton.addEventListener('click', async () => {
      const shareData = {
        title: toolTitle,
        text: toolDescription,
        url: window.location.href,
      };

      if (navigator.share) {
        try {
          await navigator.share(shareData);
        } catch {
          // el usuario cerró el panel de compartir sin elegir nada — no hacer nada
        }
        return;
      }

      try {
        await navigator.clipboard.writeText(window.location.href);
        window.Toast?.fire({ icon: 'success', title: 'Enlace copiado' });
      } catch {
        window.Toast?.fire({ icon: 'error', title: 'No se pudo copiar el enlace' });
      }
    });
  }
</script>
