---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSEO } from '../../lib/seo';

const seo = getSEO('acceso'); // Reutilizamos el SEO de acceso
---

<BaseLayout seo={seo}>
  <section class="min-h-screen flex items-center justify-center py-20">
    <div class="container-custom max-w-md mx-auto px-6">
      <!-- Logo -->
      <div>
        <h1 class="font-brand text-6xl md:text-7xl text-center mb-4 tracking-wider text-black dark:text-white">
          DCIEN
        </h1>
        <p class="text-xs text-center uppercase tracking-[0.3em] text-black/60 dark:text-white/60 mb-8">
          Activación de acceso exclusivo
        </p>
        <div class="flex justify-center mb-16">
          <button id="btn-tour" type="button" class="text-[10px] uppercase tracking-[0.2em] text-black/40 dark:text-white/40 hover:text-black dark:hover:text-white transition-colors flex items-center gap-2">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="square" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            Guía de activación
          </button>
        </div>
      </div>

      <!-- Instrucciones -->
      <div id="tour-step-1" class="mb-8 p-6 bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10">
        <h2 class="text-sm font-bold uppercase tracking-wider mb-3 text-black dark:text-white">
          📧 Credenciales temporales
        </h2>
        <p class="text-xs text-black/60 dark:text-white/60 leading-relaxed">
          Introduce las credenciales temporales que recibiste por Instagram DM. 
          Estas credenciales son de un solo uso y expiran en 1 año.
        </p>
      </div>

      <!-- Form -->
      <form id="activation-form" class="space-y-8">
        <div id="tour-step-2">
          <label for="temp-username" class="block text-xs uppercase tracking-[0.2em] mb-3 text-black/60 dark:text-white/60">
            Usuario Temporal
          </label>
          <input
            type="text"
            id="temp-username"
            name="username"
            required
            placeholder="temp_abc12345"
            class="input-minimal"
          />
        </div>

        <div id="tour-step-3">
          <label for="temp-password" class="block text-xs uppercase tracking-[0.2em] mb-3 text-black/60 dark:text-white/60">
            Contraseña Temporal
          </label>
          <input
            type="password"
            id="temp-password"
            name="password"
            required
            placeholder="••••••••"
            class="input-minimal"
          />
        </div>

        <div id="tour-step-4">
          <button type="submit" class="btn-primary w-full mt-12">
            Validar Credenciales
          </button>
        </div>

        <div class="text-center mt-8">
          <a 
            href="/acceso" 
            class="text-xs text-black/40 dark:text-white/40 hover:text-black dark:hover:text-white transition-colors uppercase tracking-[0.2em]"
          >
            ¿Ya tienes cuenta? Iniciar sesión
          </a>
        </div>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  import { driver } from 'driver.js';
  import 'driver.js/dist/driver.css';

  const activationForm = document.getElementById('activation-form') as HTMLFormElement;

  // Configuración SweetAlert2
  const getSwalConfig = () => {
    const isDark = document.documentElement.classList.contains('dark');
    return {
      background: isDark ? '#000' : '#fff',
      color: isDark ? '#fff' : '#000',
      confirmButtonColor: isDark ? '#fff' : '#000',
      customClass: {
        confirmButton: isDark 
          ? '!bg-white !text-black font-bold uppercase tracking-wider text-xs px-8 py-3 rounded-none hover:!bg-white/90' 
          : '!bg-black !text-white font-bold uppercase tracking-wider text-xs px-8 py-3 rounded-none hover:!bg-black/90',
      }
    };
  };

  // Mostrar aviso si el usuario llegó aquí por sesión caducada en completar.astro
  if (sessionStorage.getItem('activation_expired')) {
    sessionStorage.removeItem('activation_expired');
    const swalTheme = getSwalConfig();
    (window as any).Swal.fire({
      ...swalTheme,
      title: 'Sesión Expirada',
      text: 'Tu sesión de activación ha caducado. Vuelve a introducir tus credenciales temporales.',
      icon: 'warning',
      confirmButtonText: 'Entendido',
    });
  }

  // --- TOUR INTERACTIVO ---
  function startActivarTour() {
    const driverObj = driver({
      showProgress: true,
      animate: true,
      doneBtnText: '¡Entendido!',
      nextBtnText: 'Siguiente →',
      prevBtnText: '← Anterior',
      progressText: 'Paso {{current}} de {{total}}',
      steps: [
        {
          element: '#tour-step-1',
          popover: {
            title: 'Tus credenciales',
            description: 'Escribe aquí la contraseña provisional que te hemos asignado, sin modificar el formato.',
            side: 'bottom',
            align: 'start'
          }
        },
        {
          element: '#tour-step-2',
          popover: {
            title: 'Elige tu usuario',
            description: 'Escribe el nombre de usuario que quieres tener en DCIEN (ej. juan_89). Mantenlo simple, será tu acceso permanente.',
            side: 'bottom',
            align: 'start'
          }
        },
        {
          element: '#tour-step-3',
          popover: {
            title: 'Tu nueva contraseña',
            description: 'Introduce la contraseña que usarás a partir de ahora para comprar y ver tus pedidos.',
            side: 'bottom',
            align: 'start'
          }
        },
        {
          element: '#tour-step-4',
          popover: {
            title: '¡Todo listo!',
            description: 'Una vez que hayas escrito tu usuario y contraseña en los campos anteriores, haz clic aquí para validarlos.',
            side: 'bottom',
            align: 'center'
          }
        }
      ]
    });
    driverObj.drive();
  }

  const btnTour = document.getElementById('btn-tour');
  if (btnTour) {
    btnTour.addEventListener('click', startActivarTour);
  }

  if (!localStorage.getItem('dcien_tour_activar_visto')) {
    localStorage.setItem('dcien_tour_activar_visto', 'true');
    setTimeout(startActivarTour, 1000);
  }

  activationForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = new FormData(activationForm);
    const username = formData.get('username') as string;
    const password = formData.get('password') as string;

    // Validación básica
    if (!username || !password) {
      const swalTheme = getSwalConfig();
      (window as any).Swal.fire({
        ...swalTheme,
        title: 'Error',
        text: 'Por favor, completa todos los campos',
        icon: 'error',
        confirmButtonText: 'Entendido',
      });
      return;
    }

    // Deshabilitar botón
    const submitBtn = activationForm.querySelector('button[type="submit"]') as HTMLButtonElement;
    const originalText = submitBtn.textContent;
    submitBtn.disabled = true;
    submitBtn.textContent = 'VALIDANDO...';

    try {
      const response = await fetch(import.meta.env.PUBLIC_API_URL + '/auth/validate-token.php', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        credentials: 'include',
        body: JSON.stringify({ username, password }),
      });

      const data = await response.json();

      if (response.ok && data.success) {
        // Token válido - redirigir a completar registro
        const swalTheme = getSwalConfig();
        (window as any).Swal.fire({
          ...swalTheme,
          title: 'Token Válido',
          text: `Bienvenido @${data.instagram_username}`,
          icon: 'success',
          confirmButtonText: 'Continuar',
          timer: 2000,
          timerProgressBar: true,
        }).then(() => {
          window.location.href = '/registro/completar';
        });
      } else {
        // Error de validación
        const swalTheme = getSwalConfig();
        (window as any).Swal.fire({
          ...swalTheme,
          title: 'Token Inválido',
          text: data.message || 'Credenciales temporales incorrectas o expiradas',
          icon: 'error',
          confirmButtonText: 'Reintentar',
        });
        
        submitBtn.disabled = false;
        submitBtn.textContent = originalText;
      }
    } catch (error) {
      console.error('Error:', error);
      const swalTheme = getSwalConfig();
      (window as any).Swal.fire({
        ...swalTheme,
        title: 'Error de Conexión',
        text: 'No se pudo conectar con el servidor. Inténtalo de nuevo.',
        icon: 'error',
        confirmButtonText: 'Entendido',
      });
      
      submitBtn.disabled = false;
      submitBtn.textContent = originalText;
    }
  });
</script>