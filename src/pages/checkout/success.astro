---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSEO } from '../../lib/seo';

const seo = {
  title: 'Compra Confirmada | DCIEN',
  description: 'Tu compra ha sido confirmada exitosamente',
  keywords: 'confirmación, compra, dcien',
  noindex: true
};
---

<BaseLayout seo={seo}>
  <main class="relative z-10">
    <section class="min-h-screen flex flex-col items-center justify-center relative px-6 py-20">

      <!-- Logo -->
      <div class="mb-16 animate-fade-in">
        <h1 class="font-brand text-[6rem] md:text-[10rem] lg:text-[12rem] tracking-[0.05em] leading-none text-black dark:text-white">
          DCIEN
        </h1>
      </div>

      <!-- Título -->
      <div class="space-y-4 text-center animate-slide-up mb-12" style="animation-delay: 0.2s;">
        <div class="inline-block px-6 py-2 bg-black dark:bg-white">
          <h2 class="text-xs md:text-sm uppercase tracking-[0.6em] text-white dark:text-black font-bold">
            Protocolo Confirmado
          </h2>
        </div>
        
        <p class="text-[10px] md:text-xs uppercase tracking-[0.3em] text-black/60 dark:text-white/60">
          Registro Validado Correctamente
        </p>
      </div>

      <!-- Número asignado — single item -->
      <div id="number-container" class="text-center mb-12 animate-slide-up" style="animation-delay: 0.4s;">
        <p class="text-xs uppercase tracking-[0.4em] text-black/60 dark:text-white/60 mb-4">
          Tu Número Exclusivo
        </p>
        <div id="number-display" class="font-brand text-[8rem] md:text-[12rem] text-black dark:text-white leading-none">
          --
        </div>
        <p id="series-display" class="text-sm uppercase tracking-[0.3em] text-black/60 dark:text-white/60 mt-4">
          SERIE --
        </p>
      </div>

      <!-- Números asignados — multi-item (oculto por defecto) -->
      <div id="multi-number-container" class="hidden text-center mb-12 animate-slide-up" style="animation-delay: 0.4s;">
        <p class="text-xs uppercase tracking-[0.4em] text-black/60 dark:text-white/60 mb-6">
          Tus Números Exclusivos
        </p>
        <div id="multi-numbers-display" class="flex flex-wrap justify-center gap-4"></div>
      </div>

      <!-- Mensaje -->
      <div class="max-w-2xl mx-auto text-center space-y-6 mb-16 animate-slide-up" style="animation-delay: 0.6s;">
        <p class="text-sm uppercase tracking-[0.3em] text-black dark:text-white">
          Serie Integrada En Sistema
        </p>
        
        <p class="text-xs text-black/60 dark:text-white/60 leading-relaxed">
          Tu pedido ha sido confirmado. Recibirás un email con todos los detalles en 24-48 horas.
        </p>
      </div>

      <!-- Detalles del pedido -->
      <div id="order-details" class="max-w-md w-full p-6 bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 mb-12 animate-slide-up" style="animation-delay: 0.8s;">
        <h3 class="text-xs uppercase tracking-wider text-black/60 dark:text-white/60 mb-4 text-center">
          Detalles del Pedido
        </h3>
        <div id="details-content" class="space-y-2 text-sm">
          <p class="text-center text-black/40 dark:text-white/40">Cargando...</p>
        </div>
      </div>

      <!-- Botones -->
      <div class="flex flex-col md:flex-row gap-4 animate-slide-up" style="animation-delay: 1s;">
        <a href="/series-activas" class="btn-secondary">
          Ver Otras Series
        </a>
      </div>

      <!-- Info adicional -->
      <div class="mt-16 text-center text-xs text-black/40 dark:text-white/40 animate-slide-up" style="animation-delay: 1.2s;">
        <p>¿Necesitas ayuda?</p>
        <a href="mailto:soporte@d-cien.es" class="underline hover:text-black dark:hover:text-white">
          soporte@d-cien.es
        </a>
      </div>

    </section>
  </main>
</BaseLayout>

<style>
  .animate-fade-in {
    animation: fadeIn 1.5s ease-out forwards;
  }

  .animate-slide-up {
    opacity: 0;
    animation: slideUp 1s ease-out forwards;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes slideUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  import { clearCart } from '../../scripts/cart.js';

  const API = import.meta.env.PUBLIC_API_URL;

  const urlParams    = new URLSearchParams(window.location.search);
  const sessionId    = urlParams.get('session_id');

  const numberContainer      = document.getElementById('number-container');
  const multiNumberContainer = document.getElementById('multi-number-container');
  const multiNumbersDisplay  = document.getElementById('multi-numbers-display');
  const numberDisplay        = document.getElementById('number-display');
  const seriesDisplay        = document.getElementById('series-display');
  const detailsContent       = document.getElementById('details-content');

  // ── Renderizar pedido single-item ────────────────────────
  function displaySingleOrder(order: any): void {
    if (numberDisplay) {
      numberDisplay.textContent = '#' + String(order.unit_number || 0).padStart(2, '0');
    }
    if (seriesDisplay) {
      seriesDisplay.textContent = (order.series_name || order.series_slug || '').toUpperCase().replace(/-/g, ' ');
    }

    if (!detailsContent) return;

    const grandTotal  = parseFloat(String(order.price || 0));
    const shippingFee = parseFloat(String(order.shipping_fee ?? 5));
    const discountAmt = parseFloat(String(order.discount_amount || 0));
    const discountCode = order.discount_code || null;

    detailsContent.innerHTML = `
      <div class="flex justify-between py-2 border-b border-black/10 dark:border-white/10">
        <span class="text-black/60 dark:text-white/60">Serie:</span>
        <span class="font-bold">${(order.series_name || order.series_slug || 'N/A').toUpperCase().replace(/-/g,' ')}</span>
      </div>
      <div class="flex justify-between py-2 border-b border-black/10 dark:border-white/10">
        <span class="text-black/60 dark:text-white/60">Número:</span>
        <span class="font-brand text-2xl">#${String(order.unit_number || 0).padStart(2, '0')}</span>
      </div>
      <div class="flex justify-between py-2 border-b border-black/10 dark:border-white/10">
        <span class="text-black/60 dark:text-white/60">Talla:</span>
        <span>${(order.size || '').toUpperCase()}</span>
      </div>
      <div class="flex justify-between py-2 border-b border-black/10 dark:border-white/10">
        <span class="text-black/60 dark:text-white/60">Color:</span>
        <span>${order.color || 'N/A'}</span>
      </div>
      ${discountCode && discountAmt > 0 ? `
      <div class="flex justify-between py-2 border-b border-black/10 dark:border-white/10 text-green-600 dark:text-green-400">
        <span>Descuento (${discountCode}):</span>
        <span class="font-bold">-€${discountAmt.toFixed(2)}</span>
      </div>` : ''}
      <div class="flex justify-between py-2 border-b border-black/10 dark:border-white/10">
        <span class="text-black/60 dark:text-white/60">Envío:</span>
        <span>${shippingFee === 0 ? 'GRATIS' : `€${shippingFee.toFixed(2)}`}</span>
      </div>
      <div class="flex justify-between py-3 mt-1">
        <span class="font-bold text-lg">Total Pagado:</span>
        <span class="font-bold text-lg">€${grandTotal.toFixed(2)}</span>
      </div>
    `;
  }

  // ── Renderizar pedido multi-item ─────────────────────────
  function displayCartOrder(order: any, items: any[]): void {
    // Ocultar single container, mostrar multi
    numberContainer?.classList.add('hidden');
    multiNumberContainer?.classList.remove('hidden');

    // Mostrar grid de números
    if (multiNumbersDisplay) {
      multiNumbersDisplay.innerHTML = items.map((item: any) => `
        <div class="text-center px-4">
          <p class="font-brand text-[5rem] md:text-[7rem] text-black dark:text-white leading-none">
            #${String(item.unit_number).padStart(2, '0')}
          </p>
          <p class="text-[10px] uppercase tracking-[0.3em] text-black/60 dark:text-white/60 mt-1">
            ${(item.series_name || item.series_slug || '').toUpperCase().replace(/-/g,' ')}
          </p>
        </div>
      `).join('');
    }

    if (!detailsContent) return;

    const grandTotal  = parseFloat(String(order.price || 0));
    const shippingFee = parseFloat(String(order.shipping_fee ?? 5));
    const discountAmt = parseFloat(String(order.discount_amount || 0));
    const discountCode = order.discount_code || null;

    const itemsHTML = items.map((item: any) => `
      <div class="flex justify-between items-center py-2 border-b border-black/5 dark:border-white/5">
        <div>
          <span class="font-bold">${(item.series_name || item.series_slug || '').toUpperCase().replace(/-/g,' ')}</span>
          <span class="font-brand text-xl ml-2">#${String(item.unit_number).padStart(2, '0')}</span>
          <span class="text-[10px] text-black/50 dark:text-white/50 ml-2 uppercase">${item.size} · ${item.color} · ${item.type}</span>
        </div>
        <span class="font-bold shrink-0 ml-2">€${parseFloat(String(item.unit_price)).toFixed(2)}</span>
      </div>
    `).join('');

    detailsContent.innerHTML = `
      ${itemsHTML}
      ${discountCode && discountAmt > 0 ? `
      <div class="flex justify-between py-2 border-b border-black/10 dark:border-white/10 text-green-600 dark:text-green-400">
        <span>Descuento (${discountCode}):</span>
        <span class="font-bold">-€${discountAmt.toFixed(2)}</span>
      </div>` : ''}
      <div class="flex justify-between py-2 border-b border-black/10 dark:border-white/10">
        <span class="text-black/60 dark:text-white/60">Envío:</span>
        <span>${shippingFee === 0 ? 'GRATIS' : `€${shippingFee.toFixed(2)}`}</span>
      </div>
      <div class="flex justify-between py-3 mt-1">
        <span class="font-bold text-lg">Total Pagado:</span>
        <span class="font-bold text-lg">€${grandTotal.toFixed(2)}</span>
      </div>
    `;
  }

  // ── Fallback: leer del localStorage del carrito ──────────
  function displayFromCart(): boolean {
    try {
      const cart     = JSON.parse(localStorage.getItem('dcien_cart')          || '[]');
      const discount = JSON.parse(localStorage.getItem('dcien_cart_discount') || 'null');
      const shipping = JSON.parse(sessionStorage.getItem('checkout_shipping') || 'null');

      if (!cart.length) return false;

      const subtotal   = cart.reduce((s: number, i: any) => s + Number(i.price), 0);
      let   discAmt    = 0;
      if (discount) {
        discAmt = discount.type === 'percent'
          ? subtotal * (parseFloat(discount.value) / 100)
          : Math.min(parseFloat(discount.value), subtotal);
        discAmt = Math.round(discAmt * 100) / 100;
      }
      const priceAfter = Math.max(0, subtotal - discAmt);
      const ship       = priceAfter < 0.10 ? 0 : 5;
      const iva        = Math.round(priceAfter * 0.21 * 100) / 100;
      const total      = Math.round((priceAfter + iva + ship) * 100) / 100;

      if (cart.length === 1) {
        const item = cart[0];
        if (numberDisplay) numberDisplay.textContent = '#' + String(item.number).padStart(2, '0');
        if (seriesDisplay) seriesDisplay.textContent = (item.seriesName || '').toUpperCase();
        if (detailsContent) {
          detailsContent.innerHTML = `
            <div class="flex justify-between py-2 border-b border-black/10 dark:border-white/10">
              <span class="text-black/60 dark:text-white/60">Serie:</span>
              <span class="font-bold">${item.seriesName || 'N/A'}</span>
            </div>
            <div class="flex justify-between py-2 border-b border-black/10 dark:border-white/10">
              <span class="text-black/60 dark:text-white/60">Número:</span>
              <span class="font-brand text-2xl">#${String(item.number).padStart(2, '0')}</span>
            </div>
            <div class="flex justify-between py-2 border-b border-black/10 dark:border-white/10">
              <span class="text-black/60 dark:text-white/60">Talla / Color:</span>
              <span>${item.size?.toUpperCase()} · ${item.color}</span>
            </div>
            ${discAmt > 0 ? `<div class="flex justify-between py-2 border-b border-black/10 dark:border-white/10 text-green-600 dark:text-green-400"><span>Descuento:</span><span class="font-bold">-€${discAmt.toFixed(2)}</span></div>` : ''}
            <div class="flex justify-between py-2 border-b border-black/10 dark:border-white/10">
              <span class="text-black/60 dark:text-white/60">Envío:</span>
              <span>${ship === 0 ? 'GRATIS' : `€${ship.toFixed(2)}`}</span>
            </div>
            <div class="flex justify-between py-3">
              <span class="font-bold text-lg">Total Pagado:</span>
              <span class="font-bold text-lg">€${total.toFixed(2)}</span>
            </div>
          `;
        }
      } else {
        // Multi-item desde localStorage
        numberContainer?.classList.add('hidden');
        multiNumberContainer?.classList.remove('hidden');
        if (multiNumbersDisplay) {
          multiNumbersDisplay.innerHTML = cart.map((item: any) => `
            <div class="text-center px-4">
              <p class="font-brand text-[5rem] md:text-[7rem] text-black dark:text-white leading-none">
                #${String(item.number).padStart(2, '0')}
              </p>
              <p class="text-[10px] uppercase tracking-[0.3em] text-black/60 dark:text-white/60 mt-1">${item.seriesName || ''}</p>
            </div>
          `).join('');
        }
        if (detailsContent) {
          const itemsHTML = cart.map((item: any) => `
            <div class="flex justify-between items-center py-2 border-b border-black/5 dark:border-white/5">
              <div>
                <span class="font-bold">${item.seriesName}</span>
                <span class="font-brand text-xl ml-2">#${String(item.number).padStart(2, '0')}</span>
                <span class="text-[10px] text-black/50 dark:text-white/50 ml-2 uppercase">${item.size} · ${item.color}</span>
              </div>
              <span class="font-bold shrink-0 ml-2">€${Number(item.price).toFixed(2)}</span>
            </div>
          `).join('');
          detailsContent.innerHTML = `
            ${itemsHTML}
            ${discAmt > 0 ? `<div class="flex justify-between py-2 border-b border-black/10 dark:border-white/10 text-green-600 dark:text-green-400"><span>Descuento:</span><span class="font-bold">-€${discAmt.toFixed(2)}</span></div>` : ''}
            <div class="flex justify-between py-2 border-b border-black/10 dark:border-white/10"><span class="text-black/60 dark:text-white/60">Envío:</span><span>${ship === 0 ? 'GRATIS' : `€${ship.toFixed(2)}`}</span></div>
            <div class="flex justify-between py-3"><span class="font-bold text-lg">Total Pagado:</span><span class="font-bold text-lg">€${total.toFixed(2)}</span></div>
          `;
        }
      }
      return true;
    } catch { return false; }
  }

  // ── Cargar desde API ─────────────────────────────────────
  async function loadFromAPI(): Promise<boolean> {
    if (!sessionId) return false;
    try {
      const response = await fetch(
        `${API}/orders/get-by-session.php?session_id=${sessionId}`,
        { credentials: 'include' }
      );
      if (!response.ok) return false;
      const data = await response.json();
      if (!data.success || !data.order) return false;

      if (data.is_cart && data.items?.length) {
        displayCartOrder(data.order, data.items);
      } else {
        displaySingleOrder(data.order);
      }
      return true;
    } catch { return false; }
  }

  // ── Inicialización ────────────────────────────────────────
  async function init(): Promise<void> {
    const ok = await loadFromAPI();
    if (!ok) {
      const fromCart = displayFromCart();
      if (!fromCart && detailsContent) {
        detailsContent.innerHTML = `
          <div class="text-center space-y-3">
            <p class="text-xs text-black/60 dark:text-white/60">
              Recibirás un email con todos los detalles del pedido.
            </p>
            <p class="text-[10px] text-black/40 dark:text-white/40">
              Session ID: ${sessionId || 'N/A'}
            </p>
          </div>
        `;
      }
    }
  }

  init().then(() => {
    // Limpiar carrito y notificar al badge
    clearCart();
    sessionStorage.removeItem('checkout_shipping');
  });
</script>