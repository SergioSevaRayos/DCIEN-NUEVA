---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSEO } from '../../lib/seo';

const seo = {
  title: 'Datos de Envío | DCIEN',
  description: 'Completa tus datos de envío',
  keywords: 'envío, checkout, dcien',
  noindex: true
};
---

<BaseLayout seo={seo}>
  <section class="min-h-screen pt-32 pb-20">
    <div class="container-custom max-w-2xl mx-auto px-6">
      
      <!-- Header -->
      <div class="text-center mb-12">
        <h1 class="font-brand text-5xl md:text-6xl uppercase tracking-wider text-black dark:text-white mb-4">
          Datos de Envío
        </h1>
        <p class="text-sm text-black/60 dark:text-white/60 uppercase tracking-wider">
          Paso 1 de 2
        </p>
      </div>

      <!-- Resumen del producto -->
      <div id="product-summary" class="mb-12 p-6 bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10">
        <h2 class="text-xs uppercase tracking-wider text-black/60 dark:text-white/60 mb-4">
          Resumen de tu compra
        </h2>
        <div id="summary-content" class="space-y-2 text-sm">
          <!-- Se llenará con JavaScript -->
        </div>
      </div>

      <!-- Formulario -->
      <form id="shipping-form" class="space-y-8">
        
        <!-- Datos personales -->
        <div class="space-y-6">
          <h3 class="text-sm font-bold uppercase tracking-wider text-black dark:text-white border-b border-black/10 dark:border-white/10 pb-3">
            Datos Personales
          </h3>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="firstName" class="block text-xs uppercase tracking-wider mb-2 text-black/60 dark:text-white/60">
                Nombre *
              </label>
              <input
                type="text"
                id="firstName"
                name="firstName"
                required
                class="input-minimal"
                placeholder="Juan"
              />
            </div>
            
            <div>
              <label for="lastName" class="block text-xs uppercase tracking-wider mb-2 text-black/60 dark:text-white/60">
                Apellidos *
              </label>
              <input
                type="text"
                id="lastName"
                name="lastName"
                required
                class="input-minimal"
                placeholder="Pérez García"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="email" class="block text-xs uppercase tracking-wider mb-2 text-black/60 dark:text-white/60">
                Email *
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="input-minimal"
                placeholder="tu@email.com"
              />
            </div>
            
            <div>
              <label for="phone" class="block text-xs uppercase tracking-wider mb-2 text-black/60 dark:text-white/60">
                Teléfono *
              </label>
              <input
                type="tel"
                id="phone"
                name="phone"
                required
                class="input-minimal"
                placeholder="+34 600 000 000"
              />
            </div>
          </div>
        </div>

        <!-- Dirección de envío -->
        <div class="space-y-6">
          <h3 class="text-sm font-bold uppercase tracking-wider text-black dark:text-white border-b border-black/10 dark:border-white/10 pb-3">
            Dirección de Envío
          </h3>
          
          <div>
            <label for="address" class="block text-xs uppercase tracking-wider mb-2 text-black/60 dark:text-white/60">
              Dirección *
            </label>
            <input
              type="text"
              id="address"
              name="address"
              required
              class="input-minimal"
              placeholder="Calle Principal, 123"
            />
          </div>

          <div>
            <label for="addressExtra" class="block text-xs uppercase tracking-wider mb-2 text-black/60 dark:text-white/60">
              Piso / Puerta (opcional)
            </label>
            <input
              type="text"
              id="addressExtra"
              name="addressExtra"
              class="input-minimal"
              placeholder="2º B"
            />
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div>
              <label for="postalCode" class="block text-xs uppercase tracking-wider mb-2 text-black/60 dark:text-white/60">
                Código Postal *
              </label>
              <input
                type="text"
                id="postalCode"
                name="postalCode"
                required
                class="input-minimal"
                placeholder="28001"
              />
            </div>
            
            <div>
              <label for="city" class="block text-xs uppercase tracking-wider mb-2 text-black/60 dark:text-white/60">
                Ciudad *
              </label>
              <input
                type="text"
                id="city"
                name="city"
                required
                class="input-minimal"
                placeholder="Madrid"
              />
            </div>
            
            <div>
              <label for="province" class="block text-xs uppercase tracking-wider mb-2 text-black/60 dark:text-white/60">
                Provincia *
              </label>
              <input
                type="text"
                id="province"
                name="province"
                required
                class="input-minimal"
                placeholder="Madrid"
              />
            </div>
          </div>

          <div>
            <label for="country" class="block text-xs uppercase tracking-wider mb-2 text-black/60 dark:text-white/60">
              País *
            </label>
            <select
              id="country"
              name="country"
              required
              class="input-minimal"
            >
              <option value="ES">España</option>
            </select>
          </div>
        </div>

        <!-- Botones -->
        <div class="flex flex-col md:flex-row gap-4 pt-8">
          <a 
            href="javascript:history.back()" 
            class="btn-secondary flex-1 text-center"
          >
            Volver
          </a>
          <button 
            type="submit" 
            class="btn-primary flex-1"
          >
            Continuar al Resumen
          </button>
        </div>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  const shippingForm  = document.getElementById('shipping-form') as HTMLFormElement;
  const summaryContent = document.getElementById('summary-content');

  const SHIPPING_FEE = 5.00;
  const TAX_RATE     = 0.21;

  function loadCartSummary() {
    let cart: any[]  = [];
    let discount: any = null;

    try {
      cart     = JSON.parse(localStorage.getItem('dcien_cart')          || '[]');
      discount = JSON.parse(localStorage.getItem('dcien_cart_discount') || 'null');
    } catch { /* ignore */ }

    if (!cart.length) {
      window.location.href = '/series-activas';
      return;
    }

    if (!summaryContent) return;

    // Items
    const itemsHTML = cart.map((item: any) => `
      <div class="flex justify-between items-center py-1.5 border-b border-black/5 dark:border-white/5 last:border-0">
        <div>
          <span class="font-bold text-black dark:text-white">${item.seriesName}</span>
          <span class="font-brand text-lg ml-2">#${String(item.number).padStart(2, '0')}</span>
          <span class="text-[10px] text-black/50 dark:text-white/50 ml-2 uppercase">${item.size} · ${item.color} · ${item.type}</span>
        </div>
        <span class="font-bold text-black dark:text-white shrink-0 ml-2">€${Number(item.price).toFixed(2)}</span>
      </div>
    `).join('');

    // Totales
    const subtotal = cart.reduce((s: number, i: any) => s + Number(i.price), 0);

    let discAmt = 0;
    if (discount) {
      if (discount.type === 'percent') {
        discAmt = subtotal * (parseFloat(discount.value) / 100);
      } else {
        discAmt = Math.min(parseFloat(discount.value), subtotal);
      }
      discAmt = Math.round(discAmt * 100) / 100;
    }

    const priceAfterDisc = Math.max(0, subtotal - discAmt);
    const isFree         = priceAfterDisc < 0.10;
    const shipping       = isFree ? 0 : SHIPPING_FEE;
    const iva            = Math.round(priceAfterDisc * TAX_RATE * 100) / 100;
    const total          = Math.round((priceAfterDisc + iva + shipping) * 100) / 100;

    let discountHTML = '';
    if (discount && discAmt > 0) {
      discountHTML = `
        <div class="flex justify-between items-center">
          <span class="text-green-600 dark:text-green-400 text-xs">Descuento (${discount.code}):</span>
          <span class="text-green-600 dark:text-green-400 font-bold">-€${discAmt.toFixed(2)}</span>
        </div>
      `;
    }

    summaryContent.innerHTML = `
      <div class="space-y-1 mb-4">${itemsHTML}</div>
      <div class="pt-3 mt-2 border-t border-black/10 dark:border-white/10 space-y-2">
        <div class="flex justify-between items-center">
          <span class="text-black/60 dark:text-white/60">Subtotal (base):</span>
          <span class="text-black dark:text-white">€${priceAfterDisc.toFixed(2)}</span>
        </div>
        <div class="flex justify-between items-center">
          <span class="text-black/60 dark:text-white/60">IVA (21%):</span>
          <span class="text-black dark:text-white">€${iva.toFixed(2)}</span>
        </div>
        ${discountHTML}
        <div class="flex justify-between items-center">
          <span class="text-black/60 dark:text-white/60">Envío:</span>
          <span class="font-bold text-black dark:text-white">${shipping === 0 ? 'GRATIS' : `€${shipping.toFixed(2)}`}</span>
        </div>
        <div class="flex justify-between items-center pt-2 border-t border-black/5 dark:border-white/5">
          <span class="font-bold text-black dark:text-white">Total:</span>
          <span class="font-bold text-lg text-black dark:text-white">€${total.toFixed(2)}</span>
        </div>
      </div>
    `;

    // Autocompletar datos de envío si el usuario vuelve atrás
    const saved = sessionStorage.getItem('checkout_shipping');
    if (saved) {
      const s = JSON.parse(saved);
      ['firstName','lastName','email','phone','address','addressExtra','postalCode','city','province','country'].forEach(key => {
        const input = document.getElementById(key) as HTMLInputElement | null;
        if (input && s[key]) input.value = s[key];
      });
    }
  }

  shippingForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const fd = new FormData(shippingForm);

    const shippingData = {
      firstName:    fd.get('firstName')    as string,
      lastName:     fd.get('lastName')     as string,
      email:        fd.get('email')        as string,
      phone:        fd.get('phone')        as string,
      address:      fd.get('address')      as string,
      addressExtra: (fd.get('addressExtra') as string) || '',
      postalCode:   fd.get('postalCode')   as string,
      city:         fd.get('city')         as string,
      province:     fd.get('province')     as string,
      country:      (fd.get('country')     as string) || 'ES',
    };

    sessionStorage.setItem('checkout_shipping', JSON.stringify(shippingData));
    window.location.href = '/checkout/checkout-resumen';
  });

  loadCartSummary();
</script>