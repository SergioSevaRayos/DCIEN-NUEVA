---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { seriesData } from '../../data/series';

const seo = {
  title: 'Resumen del Pedido | DCIEN',
  description: 'Verifica tu pedido antes de pagar',
  noindex: true
};

const seriesConfig = seriesData.map(s => ({ slug: s.slug, price: s.price }));
---

<BaseLayout seo={seo}>
  <section class="min-h-screen pt-32 pb-20">
    <div class="container-custom max-w-3xl mx-auto px-6">
      
      <div class="text-center mb-12">
        <h1 class="font-brand text-5xl md:text-6xl uppercase tracking-wider text-black dark:text-white mb-4">
          Resumen del Pedido
        </h1>
        <p class="text-sm text-black/60 dark:text-white/60 uppercase tracking-wider">
          Paso 2 de 2 — Verifica tu pedido
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="md:col-span-2 space-y-6">

          <!-- Producto -->
          <div class="p-6 bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10">
            <h2 class="text-sm font-bold uppercase tracking-wider text-black dark:text-white mb-6 pb-3 border-b border-black/10 dark:border-white/10">
              Tu Producto
            </h2>
            <div id="product-details" class="space-y-3 text-sm"></div>
          </div>

          <!-- Envío -->
          <div class="p-6 bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10">
            <div class="flex justify-between items-start mb-6 pb-3 border-b border-black/10 dark:border-white/10">
              <h2 class="text-sm font-bold uppercase tracking-wider text-black dark:text-white">Datos de Envío</h2>
              <a href="/checkout/checkout-datos-envio" class="text-xs text-black/60 dark:text-white/60 hover:text-black dark:hover:text-white uppercase tracking-wider">Editar</a>
            </div>
            <div id="shipping-details" class="space-y-2 text-sm"></div>
          </div>

          <!-- Descuento aplicado (visible solo si hay descuento) -->
          <div id="discount-applied-card" class="hidden p-6 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800">
            <div class="flex justify-between items-center">
              <div>
                <h2 class="text-sm font-bold uppercase tracking-wider text-green-800 dark:text-green-300">✓ Descuento Aplicado</h2>
                <p id="discount-card-desc" class="text-xs text-green-700 dark:text-green-400 mt-1 uppercase tracking-widest"></p>
              </div>
              <span id="discount-card-badge" class="text-sm font-bold uppercase px-3 py-1 bg-green-600 text-white dark:bg-green-500 dark:text-black"></span>
            </div>
          </div>

        </div>

        <!-- Sidebar desglose -->
        <div class="space-y-6">
          <div class="p-6 bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10">
            <h2 class="text-sm font-bold uppercase tracking-wider text-black dark:text-white mb-6 pb-3 border-b border-black/10 dark:border-white/10">
              Desglose
            </h2>
            <div class="space-y-3 text-sm">
              <div class="flex justify-between">
                <span class="text-black/60 dark:text-white/60">Subtotal (Base):</span>
                <span id="subtotal-price" class="text-black dark:text-white">€0.00</span>
              </div>
              <div class="flex justify-between">
                <span class="text-black/60 dark:text-white/60">IVA (21%):</span>
                <span id="tax-price" class="text-black dark:text-white">€0.00</span>
              </div>
              <div class="flex justify-between border-b border-black/5 pb-2">
                <span class="text-black/60 dark:text-white/60">Envío:</span>
                <span id="shipping-cost" class="text-black dark:text-white">€0.00</span>
              </div>

              <!-- Fila de descuento (oculta si no hay) -->
              <div id="discount-row" class="hidden justify-between text-green-600 dark:text-green-400">
                <span id="discount-row-label" class="font-medium">Descuento:</span>
                <span id="discount-row-amount" class="font-bold">-€0.00</span>
              </div>

              <div class="pt-3 flex justify-between items-center">
                <span class="font-bold uppercase text-black dark:text-white">Total a Pagar:</span>
                <span id="total-price" class="text-2xl font-brand text-black dark:text-white">€0.00</span>
              </div>
            </div>
          </div>

          <div class="space-y-4">
            <label class="flex items-start gap-2 cursor-pointer text-[10px] text-black/60 dark:text-white/60">
              <input type="checkbox" id="terms-checkbox" class="mt-1" />
              <span>Acepto los <a href="/condiciones" class="underline">términos</a> y la <a href="/privacidad" class="underline">privacidad</a>.</span>
            </label>
            <button id="confirm-button" disabled class="btn-primary w-full disabled:opacity-50">
              Confirmar y Pagar
            </button>
            <p id="confirm-error" class="text-[10px] text-red-500 text-center uppercase tracking-widest hidden"></p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ seriesConfig }}>
  const API = 'https://d-cien.es/api';
  let SHIPPING_FEE = 5.00; // Lo cambiamos de 'const' a 'let'
  const TAX_RATE = 0.21;

  const productDetails = document.getElementById('product-details');
  const shippingDetails = document.getElementById('shipping-details');
  const subtotalElement = document.getElementById('subtotal-price');
  const taxElement = document.getElementById('tax-price');
  const shippingCostEl = document.getElementById('shipping-cost');
  const totalElement = document.getElementById('total-price');
  const confirmButton = document.getElementById('confirm-button');
  const termsCheckbox = document.getElementById('terms-checkbox');
  const confirmError = document.getElementById('confirm-error');

  // ═══════════════════════════════════════════════════════════════
  // CARGAR Y MOSTRAR DATOS DEL CHECKOUT
  // ═══════════════════════════════════════════════════════════════
  function loadCheckoutData() {
    const dataRaw = sessionStorage.getItem('checkout_data');
    
    if (!dataRaw) {
      console.error('No hay datos de checkout');
      window.location.href = '/series-activas';
      return;
    }

    const checkoutData = JSON.parse(dataRaw);
    console.log('Datos de checkout:', checkoutData);

    const currentSeries = seriesConfig.find(s => s.slug === checkoutData.seriesSlug);
    const officialPrice = currentSeries ? parseFloat(currentSeries.price) : 0;

    if (!officialPrice) {
      console.error('No se pudo obtener precio de la serie');
      return;
    }

    const discount = checkoutData.discount || null;

    // ═══════════════════════════════════════════════════════════════
    // MOSTRAR PRODUCTO
    // ═══════════════════════════════════════════════════════════════
    if (productDetails) {
      productDetails.innerHTML = `
        <div class="flex justify-between py-1">
          <span class="text-black/60 dark:text-white/60">Serie:</span>
          <span class="font-bold">${checkoutData.seriesName || 'N/A'}</span>
        </div>
        <div class="flex justify-between py-1">
          <span class="text-black/60 dark:text-white/60">Número:</span>
          <span class="font-brand text-xl">#${String(checkoutData.number).padStart(2, '0')}</span>
        </div>
        <div class="flex justify-between py-1">
          <span class="text-black/60 dark:text-white/60">Talla:</span>
          <span>${checkoutData.size?.toUpperCase() || 'N/A'}</span>
        </div>
        <div class="flex justify-between py-1">
          <span class="text-black/60 dark:text-white/60">Color:</span>
          <span>${checkoutData.color || 'N/A'}</span>
        </div>
        <div class="flex justify-between py-1">
          <span class="text-black/60 dark:text-white/60">Tipo:</span>
          <span>${checkoutData.type || 'standard'}</span>
        </div>
      `;
    }

    // ═══════════════════════════════════════════════════════════════
    // MOSTRAR ENVÍO
    // ═══════════════════════════════════════════════════════════════
    if (shippingDetails && checkoutData.shipping) {
      const s = checkoutData.shipping;
      shippingDetails.innerHTML = `
        <div class="font-bold">${s.firstName} ${s.lastName}</div>
        <div>${s.address}${s.addressExtra ? ', ' + s.addressExtra : ''}</div>
        <div>${s.postalCode} ${s.city}, ${s.province || ''}</div>
        <div class="text-xs opacity-60 mt-2">${s.email} | ${s.phone}</div>
      `;
    }

    // ═══════════════════════════════════════════════════════════════
    // CALCULAR DESCUENTO Y REGLA ENVÍO GRATIS
    // ═══════════════════════════════════════════════════════════════
    let discountAmount = 0;

    if (discount) {
      if (checkoutData.finalPrice !== undefined && checkoutData.originalPrice !== undefined) {
        discountAmount = checkoutData.originalPrice - checkoutData.finalPrice;
      } else {
        if (discount.type === 'percent') {
          discountAmount = officialPrice * (parseFloat(discount.value) / 100);
        } else {
          discountAmount = Math.min(parseFloat(discount.value), officialPrice);
        }
      }
      discountAmount = Math.round(discountAmount * 100) / 100;

      // REGLA: Si el descuento es del 100%, envío gratis
      if (discount.type === 'percent' && parseFloat(discount.value) === 100) {
        SHIPPING_FEE = 0;
      }
    }

    // ═══════════════════════════════════════════════════════════════
    // CALCULAR DESGLOSE (BASE + IVA + ENVÍO)
    // ═══════════════════════════════════════════════════════════════
    const priceAfterDiscount = officialPrice - discountAmount;
    const subtotalBase = Math.max(0, priceAfterDiscount); 
    const ivaAmount = subtotalBase * TAX_RATE;
    const finalTotal = Math.max(0, subtotalBase + ivaAmount + SHIPPING_FEE);

    if (subtotalElement) subtotalElement.textContent = `€${subtotalBase.toFixed(2)}`;
    if (taxElement) taxElement.textContent = `€${ivaAmount.toFixed(2)}`;
    if (shippingCostEl) shippingCostEl.textContent = SHIPPING_FEE === 0 ? 'GRATIS' : `€${SHIPPING_FEE.toFixed(2)}`;
    if (totalElement) totalElement.textContent = `€${finalTotal.toFixed(2)}`;

    // ═══════════════════════════════════════════════════════════════
    // UI - FILA Y TARJETA DESCUENTO
    // ═══════════════════════════════════════════════════════════════
    const discRow = document.getElementById('discount-row');
    const discRowLabel = document.getElementById('discount-row-label');
    const discRowAmount = document.getElementById('discount-row-amount');

    if (discount && discountAmount > 0 && discRow) {
      if (discRowLabel) discRowLabel.textContent = `Descuento (${discount.code}):`;
      if (discRowAmount) discRowAmount.textContent = `-€${discountAmount.toFixed(2)}`;
      discRow.classList.remove('hidden');
      discRow.classList.add('flex');
    }

    const discCard = document.getElementById('discount-applied-card');
    const discCardDesc = document.getElementById('discount-card-desc');
    const discCardBadge = document.getElementById('discount-card-badge');

    if (discount && discCard) {
      if (discCardDesc) discCardDesc.textContent = `${discount.description || discount.code}`;
      if (discCardBadge) discCardBadge.textContent = discount.label || `-${discount.value}%`;
      discCard.classList.remove('hidden');
    }

    // Cambiar el texto del botón si es gratis
    if (finalTotal === 0 && confirmButton) {
      confirmButton.textContent = 'GENERAR ORDEN (GRATIS)';
    }
  }

  // ═══════════════════════════════════════════════════════════════
  // EVENTOS
  // ═══════════════════════════════════════════════════════════════
  termsCheckbox?.addEventListener('change', () => {
    if (confirmButton) {
      confirmButton.disabled = !termsCheckbox.checked;
    }
  });

  confirmButton?.addEventListener('click', async () => {
    const dataRaw = sessionStorage.getItem('checkout_data');
    if (!dataRaw) return;

    const checkoutData = JSON.parse(dataRaw);
    const discount = checkoutData.discount || null;

    confirmButton.disabled = true;
    confirmButton.textContent = 'PROCESANDO...';
    if (confirmError) confirmError.classList.add('hidden');

    try {
      const payload = {
        seriesSlug: checkoutData.seriesSlug,
        unitNumber: parseInt(checkoutData.number),
        size: checkoutData.size,
        color: checkoutData.color,
        type: checkoutData.type || 'standard',
        shippingData: checkoutData.shipping,
        originalPrice: checkoutData.originalPrice || null,
        finalPrice: checkoutData.finalPrice || null,
        discount: discount ? {
          id: discount.id || null,
          user_discount_id: discount.user_discount_id || null,
          code: discount.code,
          type: discount.type,
          value: discount.value,
          description: discount.description || null
        } : null
      };

      const response = await fetch(`${API}/stripe/create-checkout-session.php`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify(payload)
      });

      const result = await response.json();

      if (result.success && result.url) {
        window.location.href = result.url;
      } else {
        throw new Error(result.message || 'Error en la respuesta del servidor');
      }
    } catch (error) {
      if (confirmError) {
        confirmError.textContent = error.message || 'Error de conexión con el servidor';
        confirmError.classList.remove('hidden');
      }
      if (confirmButton) {
        confirmButton.disabled = false;
        confirmButton.textContent = 'Confirmar y Pagar';
      }
    }
  });

  loadCheckoutData();
</script>