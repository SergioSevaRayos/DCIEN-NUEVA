---
/**
 * Componente SEO Compatible con estructura actual
 * + Schema.org JSON-LD
 */
import { getOrganizationSchema, getWebsiteSchema, getWebPageSchema } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  keywords: string;
  ogImage?: string;
  ogType?: string;       // 'website' | 'product' etc.
  ogImageAlt?: string;   // Alt text descriptivo para la imagen OG
  canonical?: string;
  noindex?: boolean;
  nofollow?: boolean;
  schemas?: any[];
}

const { 
  title, 
  description, 
  keywords, 
  ogImage, 
  ogType = 'website',
  ogImageAlt,
  canonical,
  noindex = false,
  nofollow = false,
  schemas = []
} = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') + '/';
const canonicalURL = new URL(path, Astro.site);
const ogImageURL = ogImage ? new URL(ogImage, Astro.site) : null;

// Robots meta
const robotsContent = [
  noindex ? 'noindex' : 'index',
  nofollow ? 'nofollow' : 'follow'
].join(',');

// Schemas por defecto (Organization, Website, WebPage)
const defaultSchemas = [
  getOrganizationSchema(),
  getWebsiteSchema(),
  getWebPageSchema(title, description, canonicalURL.toString())
];

// Combinar con schemas adicionales
const allSchemas = [...defaultSchemas, ...schemas];
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Robots -->
<meta name="robots" content={robotsContent} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content="DCIEN" />
<meta property="og:locale" content="es_ES" />
{ogImageURL && <meta property="og:image" content={ogImageURL.href} />}
{ogImageURL && <meta property="og:image:secure_url" content={ogImageURL.href} />}
{ogImageURL && <meta property="og:image:width" content="1200" />}
{ogImageURL && <meta property="og:image:height" content="630" />}
{ogImageURL && <meta property="og:image:type" content="image/png" />}
{ogImageURL && ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:site" content="@dcien" />
{ogImageURL && <meta property="twitter:image" content={ogImageURL.href} />}
{ogImageURL && ogImageAlt && <meta property="twitter:image:alt" content={ogImageAlt} />}

<!-- Additional SEO -->
<meta name="language" content="Spanish" />
<meta name="author" content="DCIEN" />

<!-- Mobile -->
<meta name="format-detection" content="telephone=no" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="theme-color" content="#000000" />

<!-- JSON-LD Structured Data -->
{allSchemas.map((schema) => (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
))}

<!-- Preconnect to important domains -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />