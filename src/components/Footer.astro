---
const currentYear = new Date().getFullYear();
---

<footer class="bg-white dark:bg-black border-t border-black/5 dark:border-white/10 py-16 mt-32 transition-colors duration-300">
  <div class="container-custom">
    <div class="text-center mb-12">
      <h3 class="font-brand text-3xl mb-3 tracking-wider text-black dark:text-white">DCIEN</h3>
      <p class="text-xs text-black/40 dark:text-white/40 uppercase tracking-[0.3em]">Unique & Exclusive</p>
    </div>

    <div class="flex flex-wrap justify-center gap-x-8 gap-y-4 text-xs uppercase tracking-[0.2em] mb-12">
      <a href="/aviso-legal" class="text-black/50 dark:text-white/40 hover:text-black dark:hover:text-white transition-colors">Aviso Legal</a>
      <a href="/privacidad" class="text-black/50 dark:text-white/40 hover:text-black dark:hover:text-white transition-colors">Privacidad</a>
      <a href="/cookies" class="text-black/50 dark:text-white/40 hover:text-black dark:hover:text-white transition-colors">Cookies</a>
      <a href="/condiciones" class="text-black/50 dark:text-white/40 hover:text-black dark:hover:text-white transition-colors">Condiciones</a>
      <a href="/devoluciones" class="text-black/50 dark:text-white/40 hover:text-black dark:hover:text-white transition-colors">Devoluciones</a>
    </div>

    <div class="text-center text-xs text-black/30 dark:text-white/30">
      <p>© {currentYear} DCIEN. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>