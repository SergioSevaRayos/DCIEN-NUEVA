---
// CartDrawer.astro — Panel lateral del carrito (sin props, se gestiona por JS)
---

<!-- Overlay de fondo -->
<div
  id="cart-overlay"
  class="fixed inset-0 bg-black/40 z-50 opacity-0 pointer-events-none transition-opacity duration-300"
  aria-hidden="true"
></div>

<!-- Panel lateral -->
<div
  id="cart-drawer"
  class="fixed top-0 right-0 h-full w-full max-w-sm bg-white dark:bg-black border-l border-black/10 dark:border-white/10 z-50 flex flex-col translate-x-full transition-transform duration-300 ease-in-out"
  role="dialog"
  aria-label="Carrito de compra"
>
  <!-- Header del drawer -->
  <div class="flex items-center justify-between px-6 py-5 border-b border-black/10 dark:border-white/10">
    <div class="flex items-center gap-3">
      <span class="font-brand text-2xl text-black dark:text-white">Carrito</span>
      <span id="cart-drawer-count" class="text-[10px] uppercase tracking-widest text-black/40 dark:text-white/40"></span>
      <button id="btn-tour-cart" type="button" class="text-[9px] uppercase tracking-[0.2em] text-black/40 dark:text-white/40 hover:text-black dark:hover:text-white transition-colors flex items-center gap-1 ml-2 hidden">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="square" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        Guía
      </button>
    </div>
    <button
      id="cart-close"
      class="p-2 text-black/50 dark:text-white/50 hover:text-black dark:hover:text-white transition-colors"
      aria-label="Cerrar carrito"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <!-- Contenido: vacío o lista de items -->
  <div class="flex-1 overflow-y-auto px-6 py-6">
    <!-- Estado vacío -->
    <div id="cart-empty" class="hidden flex-col items-center justify-center h-full text-center py-16">
      <svg class="w-12 h-12 text-black/20 dark:text-white/20 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
      </svg>
      <p class="text-xs uppercase tracking-[0.2em] text-black/40 dark:text-white/40">El carrito está vacío</p>
      <a href="/series-activas" id="cart-go-shop" class="mt-6 text-[10px] uppercase tracking-widest underline text-black/60 dark:text-white/60 hover:text-black dark:hover:text-white">
        Ver series activas
      </a>
    </div>

    <!-- Lista de items -->
    <div id="cart-items-list" class="hidden space-y-4"></div>

    <!-- Sección de descuentos -->
    <div id="cart-discount-section" class="mt-4 p-4 bg-zinc-50 dark:bg-zinc-900 border border-black/5 dark:border-white/5 space-y-4">
      <h4 class="text-[9px] uppercase tracking-widest font-bold text-black/60 dark:text-white/60">Añadir Descuento</h4>
      
      <div id="cart-personal-discounts" class="space-y-3"></div>

      <div class="flex gap-2">
        <input id="cart-coupon-input" type="text" placeholder="CÓDIGO PROMOCIONAL" class="flex-1 border border-black/10 dark:border-white/10 bg-white dark:bg-black px-3 py-2 text-[10px] uppercase tracking-widest placeholder-black/20 focus:outline-none" />
        <button id="cart-apply-coupon-btn" class="px-4 py-2 bg-black text-white dark:bg-white dark:text-black text-[10px] uppercase tracking-widest font-bold">Validar</button>
      </div>
      <p id="cart-coupon-msg" class="text-[9px] uppercase tracking-widest hidden"></p>
    </div>
  </div>

  <!-- Footer: totales + botones -->
  <div id="cart-footer" class="hidden border-t border-black/10 dark:border-white/10 px-6 py-6 space-y-4">
    <div class="space-y-2 text-sm">
      <div class="flex justify-between text-black/60 dark:text-white/60">
        <span class="text-[11px] uppercase tracking-wider">Subtotal (base)</span>
        <span id="cart-subtotal">€0.00</span>
      </div>
      <div class="flex justify-between text-black/60 dark:text-white/60">
        <span class="text-[11px] uppercase tracking-wider">IVA (21% incl.)</span>
        <span id="cart-iva">€0.00</span>
      </div>
      <div id="cart-discount-row" class="hidden flex justify-between text-green-600 dark:text-green-400">
        <span class="text-[11px] uppercase tracking-wider">Descuento</span>
        <span id="cart-discount-amount">-€0.00</span>
      </div>
      <div class="flex justify-between text-black/60 dark:text-white/60">
        <span class="text-[11px] uppercase tracking-wider">Envío</span>
        <span id="cart-shipping">€10.00</span>
      </div>
      <div class="flex justify-between pt-3 border-t border-black/10 dark:border-white/10">
        <span class="text-xs uppercase tracking-widest font-bold text-black dark:text-white">Total</span>
        <span id="cart-total" class="font-brand text-xl text-black dark:text-white">€0.00</span>
      </div>
    </div>

    <a
      href="/checkout/checkout-datos-envio"
      id="cart-checkout-btn"
      class="block w-full py-4 bg-black text-white dark:bg-white dark:text-black text-[11px] uppercase tracking-[0.3em] font-bold text-center transition-opacity hover:opacity-80"
    >
      Ir al pago →
    </a>

    <button
      id="cart-continue"
      class="w-full text-[10px] uppercase tracking-widest text-black/40 dark:text-white/40 hover:text-black dark:hover:text-white transition-colors py-1"
    >
      Seguir comprando
    </button>
  </div>
</div>

<script>
  import { driver } from 'driver.js';
  import 'driver.js/dist/driver.css';
  import { getCart, getDiscounts, setDiscounts, removeFromCart, getCartSubtotal } from '../scripts/cart.js';

  const SHIPPING_FEE = 10.00;
  const TAX_RATE = 0.21;
  const API = import.meta.env.PUBLIC_API_URL;

  const overlay      = document.getElementById('cart-overlay');
  const drawer       = document.getElementById('cart-drawer');
  const closeBtn     = document.getElementById('cart-close');
  const continueBtn  = document.getElementById('cart-continue');
  const emptyEl      = document.getElementById('cart-empty');
  const itemsList    = document.getElementById('cart-items-list');
  const footer       = document.getElementById('cart-footer');
  const countLabel   = document.getElementById('cart-drawer-count');
  
  const discountSection = document.getElementById('cart-discount-section');
  const personalDiscountsContainer = document.getElementById('cart-personal-discounts');
  const couponInput = document.getElementById('cart-coupon-input') as HTMLInputElement | null;
  const applyCouponBtn = document.getElementById('cart-apply-coupon-btn') as HTMLButtonElement | null;
  const couponMsg = document.getElementById('cart-coupon-msg');
  
  const discountRow    = document.getElementById('cart-discount-row');
  const discountAmount = document.getElementById('cart-discount-amount');
  const subtotalEl   = document.getElementById('cart-subtotal');
  const ivaEl        = document.getElementById('cart-iva');
  const shippingEl   = document.getElementById('cart-shipping');
  const totalEl      = document.getElementById('cart-total');

  let availableDiscounts: any[] = [];
  let loadedDiscounts = false;

  async function loadUserDiscounts() {
    if (loadedDiscounts) return;
    try {
      const res = await fetch(`${API}/auth/check.php`, { credentials: 'include' });
      const session = await res.json();
      if (!session.authenticated) {
        if (getDiscounts().length > 0) {
          setDiscounts([]);
        }
        loadedDiscounts = true; // Prevent re-fetching if not logged in
        return;
      }
      
      const r2 = await fetch(`${API}/discounts/get-user-discount.php?series_slug=*&t=${Date.now()}`, { credentials: 'include' });
      const d2 = await r2.json();
      if (d2.success && d2.discounts) {
        availableDiscounts = d2.discounts;
        loadedDiscounts = true;
        
        let current = getDiscounts();
        if (current.length === 0 && availableDiscounts.length > 0) {
          setDiscounts(availableDiscounts.filter((d: any) => d.is_stackable || availableDiscounts.length === 1));
        } else if (current.length > 0) {
          // Limpiar descuentos que tienen user_discount_id pero NO están en mis descuentos disponibles
          const validCurrent = current.filter((c: any) => {
            if (!c.user_discount_id) return true; // Mantener cupones manuales
            return availableDiscounts.some((ad: any) => ad.user_discount_id === c.user_discount_id);
          });
          if (validCurrent.length !== current.length) {
            setDiscounts(validCurrent);
          } else {
            renderCart();
          }
        } else {
          renderCart();
        }
      }
    } catch (err) {
      console.error('Error loading cart discounts:', err);
    }
  }

  function openDrawer() {
    overlay?.classList.remove('opacity-0', 'pointer-events-none');
    drawer?.classList.remove('translate-x-full');
    document.body.style.overflow = 'hidden';
    loadUserDiscounts();

    // Auto-iniciar tour del carrito si no se ha visto y hay items
    if (getCart().length > 0) {
      document.getElementById('btn-tour-cart')?.classList.remove('hidden');
      if (!localStorage.getItem('dcien_tour_carrito_visto')) {
        localStorage.setItem('dcien_tour_carrito_visto', 'true');
        setTimeout(() => startCartTour(), 500);
      }
    } else {
      document.getElementById('btn-tour-cart')?.classList.add('hidden');
    }
  }

  function closeDrawer() {
    overlay?.classList.add('opacity-0', 'pointer-events-none');
    drawer?.classList.add('translate-x-full');
    document.body.style.overflow = '';
  }

  // Cupones manuales
  applyCouponBtn?.addEventListener('click', async () => {
    const code = couponInput?.value.trim();
    if (!code) return;

    if (applyCouponBtn) {
      applyCouponBtn.textContent = '...';
      applyCouponBtn.disabled = true;
    }

    try {
      // Validate code
      const res = await fetch(`${API}/discounts/validate-discount.php?code=${encodeURIComponent(code)}`, { credentials: 'include' });
      const data = await res.json();
      
      if (data.success && data.discount) {
        const current = getDiscounts();
        // If it's not stackable, clear others. If it is stackable, just add it.
        if (!data.discount.is_stackable) {
          setDiscounts([data.discount]);
        } else {
          if (!current.find((d: any) => d.code === code)) {
             current.push(data.discount);
             setDiscounts(current);
          }
        }
        if (couponMsg) {
          couponMsg.textContent = 'Cupón aplicado';
          couponMsg.classList.replace('text-red-500', 'text-green-500');
          couponMsg.classList.remove('hidden');
        }
        if (couponInput) couponInput.value = '';
      } else {
        throw new Error(data.message || 'Cupón inválido');
      }
    } catch (err: any) {
      if (couponMsg) {
        couponMsg.textContent = err.message || 'Error validando cupón';
        couponMsg.classList.replace('text-green-500', 'text-red-500');
        couponMsg.classList.remove('hidden');
      }
    } finally {
      if (applyCouponBtn) {
        applyCouponBtn.textContent = 'Validar';
        applyCouponBtn.disabled = false;
      }
      setTimeout(() => couponMsg?.classList.add('hidden'), 3000);
    }
  });

  function renderCart() {
    const cart      = getCart();
    const discounts = getDiscounts();
    const count     = cart.length;

    if (countLabel) countLabel.textContent = count > 0 ? `${count} item${count > 1 ? 's' : ''}` : '';

    if (count === 0) {
      emptyEl?.classList.remove('hidden');
      emptyEl?.classList.add('flex');
      itemsList?.classList.add('hidden');
      footer?.classList.add('hidden');
      discountSection?.classList.add('hidden');
      return;
    }

    emptyEl?.classList.add('hidden');
    emptyEl?.classList.remove('flex');
    itemsList?.classList.remove('hidden');
    footer?.classList.remove('hidden');
    discountSection?.classList.remove('hidden');

    // Render items
    if (itemsList) {
      itemsList.innerHTML = (cart as any[]).map((item: any, idx: number) => `
        <div class="flex items-start gap-4 py-4 border-b border-black/5 dark:border-white/5">
          <div class="flex-1 min-w-0">
            <p class="font-bold text-xs uppercase tracking-wider text-black dark:text-white">${item.seriesName}</p>
            <p class="font-brand text-2xl text-black dark:text-white leading-none mt-0.5">#${String(item.number).padStart(2, '0')}</p>
            <p class="text-[10px] uppercase tracking-widest text-black/50 dark:text-white/50 mt-1">
              ${item.size.toUpperCase()} · ${item.color} · ${item.type === 'king-size' ? 'Oversize' : 'Standard'}
            </p>
            <p class="text-xs font-bold text-black dark:text-white mt-1">€${item.price.toFixed(2)}</p>
          </div>
          <button
            data-remove-idx="${idx}"
            class="shrink-0 p-1.5 text-black/30 dark:text-white/30 hover:text-red-500 dark:hover:text-red-400 transition-colors mt-0.5"
            aria-label="Eliminar item"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>
      `).join('');

      itemsList.querySelectorAll('[data-remove-idx]').forEach(btn => {
        btn.addEventListener('click', () => {
          const idx = parseInt((btn as HTMLElement).dataset.removeIdx ?? '0');
          removeFromCart(idx);
        });
      });
    }

    // Calcular totales
    const subtotal = getCartSubtotal(cart);

    let discAmt = 0;
    if (discounts && discounts.length > 0) {
      for (const d of discounts) {
        if (d.type === 'percent') discAmt += subtotal * (parseFloat(d.value) / 100);
        else                      discAmt += parseFloat(d.value);
      }
      discAmt = Math.min(Math.round(discAmt * 100) / 100, subtotal);
    }

    const priceAfterDisc = Math.max(0, subtotal - discAmt);
    const isFree         = priceAfterDisc < 0.10;
    const shipping       = isFree ? 0 : SHIPPING_FEE;
    const iva            = Math.round((priceAfterDisc - (priceAfterDisc / (1 + TAX_RATE))) * 100) / 100;
    const total          = Math.round((priceAfterDisc + shipping) * 100) / 100;

    if (subtotalEl) subtotalEl.textContent = `€${subtotal.toFixed(2)}`;
    if (ivaEl)      ivaEl.textContent      = `€${iva.toFixed(2)}`;
    if (shippingEl) shippingEl.textContent = shipping === 0 ? 'GRATIS' : `€${shipping.toFixed(2)}`;
    if (totalEl)    totalEl.textContent    = `€${total.toFixed(2)}`;

    // Render discount section (Checkboxes)
    if (personalDiscountsContainer && availableDiscounts.length > 0) {
      const appliedIds = discounts.map((d: any) => d.user_discount_id || d.id || d.code);
      personalDiscountsContainer.innerHTML = availableDiscounts.map((d: any) => {
        const isChecked = appliedIds.includes(d.user_discount_id) || appliedIds.includes(d.id) || appliedIds.includes(d.code);
        return `
          <label class="flex items-start gap-3 cursor-pointer">
            <input type="checkbox" class="peer sr-only cart-discount-cb" data-code="${d.code}" ${isChecked ? 'checked' : ''} />
            <div class="w-5 h-5 border-2 border-black/20 dark:border-white/20 peer-checked:border-black dark:peer-checked:border-white peer-checked:bg-black dark:peer-checked:bg-white transition-all flex items-center justify-center">
              <svg class="w-3 h-3 text-white dark:text-black ${isChecked ? '' : 'hidden'}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path d="M5 13l4 4L19 7"/></svg>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-xs font-bold text-black dark:text-white uppercase tracking-tighter">DESCUENTO: ${d.code}</p>
              <p class="text-[9px] text-black/50 dark:text-white/50 uppercase tracking-widest mt-0.5">${d.description || ''}</p>
            </div>
            <span class="text-xs font-bold text-green-600 dark:text-green-400 self-center">${d.label || `-${d.value}%`}</span>
          </label>
        `;
      }).join('');
      
      // Checkbox events
      personalDiscountsContainer.querySelectorAll('.cart-discount-cb').forEach(cb => {
        cb.addEventListener('change', (e: any) => {
          const code = e.target.dataset.code;
          const discObj = availableDiscounts.find((d: any) => d.code === code);
          let current = getDiscounts();
          if (e.target.checked) {
             if (!current.find((d: any) => d.code === code)) current.push(discObj);
          } else {
             current = current.filter((d: any) => d.code !== code);
          }
          setDiscounts(current); // Triggers cart:updated
        });
      });
    } else if (personalDiscountsContainer) {
      personalDiscountsContainer.innerHTML = '';
    }

    // Descuento UI in totals row
    if (discAmt > 0 && discounts.length > 0) {
      discountRow?.classList.remove('hidden');
      discountRow?.classList.add('flex');
      if (discountAmount) discountAmount.textContent = `-€${discAmt.toFixed(2)}`;
    } else {
      discountRow?.classList.add('hidden');
      discountRow?.classList.remove('flex');
    }
  }

  // Eventos
  closeBtn?.addEventListener('click', closeDrawer);
  continueBtn?.addEventListener('click', closeDrawer);
  overlay?.addEventListener('click', closeDrawer);

  window.addEventListener('cart:updated', renderCart);
  window.addEventListener('cart:open', openDrawer);

  document.getElementById('cart-icon-btn')?.addEventListener('click', openDrawer);

  // Render inicial
  renderCart();
  
  // Call loadUserDiscounts immediately if we are on checkout page or already opened
  loadUserDiscounts();

  // --- TOUR INTERACTIVO DEL CARRITO ---
  function startCartTour() {
    const cartDriverObj = driver({
      showProgress: true,
      animate: true,
      doneBtnText: '¡Entendido!',
      nextBtnText: 'Siguiente →',
      prevBtnText: '← Anterior',
      progressText: 'Paso {{current}} de {{total}}',
      steps: [
        {
          element: '#cart-items-list',
          popover: {
            title: 'Tus Selecciones',
            description: 'Aquí puedes revisar las prendas que has añadido, junto con tu talla, color, tipo de corte y, lo más importante, el número exclusivo reservado para ti.',
            side: 'left',
            align: 'start'
          }
        },
        {
          element: '#cart-discount-section',
          popover: {
            title: 'Descuentos Personales',
            description: 'Si tienes un código promocional o si te hemos concedido descuentos en tu cuenta (ej. descuento por defecto), podrás activarlos o introducirlos aquí.',
            side: 'left',
            align: 'start'
          }
        },
        {
          element: '#cart-footer',
          popover: {
            title: 'Finalizar Pedido',
            description: 'Revisa tus totales, descuentos aplicados y haz clic en "Ir al pago" cuando estés listo para completar la compra de forma segura.',
            side: 'left',
            align: 'center'
          }
        }
      ]
    });
    cartDriverObj.drive();
  }

  document.getElementById('btn-tour-cart')?.addEventListener('click', startCartTour);
</script>
